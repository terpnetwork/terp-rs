{
  "contract_name": "marketplace-mirror",
  "contract_version": "0.1.0",
  "idl_version": "1.0.0",
  "instantiate": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "InstantiateMsg",
    "type": "object",
    "required": [
      "accepted_denom",
      "admin"
    ],
    "properties": {
      "accepted_denom": {
        "description": "Bank denom accepted for purchases (e.g. `uterp`).",
        "type": "string"
      },
      "admin": {
        "description": "Contract admin (also protocol-fee recipient when fee is set).",
        "type": "string"
      },
      "auto_execute_ingress": {
        "description": "Governance flag: allow a relayer to auto-execute `Purchase` from Nostr ingress. **Default false** — parse-intent only. The contract never submits txs itself.",
        "default": false,
        "type": "boolean"
      },
      "min_buffer_blocks": {
        "description": "Settlement buffer in blocks. Default **7**. Allowed range **5–10**.",
        "default": 7,
        "type": "integer",
        "format": "uint64",
        "minimum": 0.0
      },
      "protocol_fee_bps": {
        "description": "Optional protocol fee in basis points (100 = 1%). Taken on settle.",
        "default": null,
        "type": [
          "integer",
          "null"
        ],
        "format": "uint64",
        "minimum": 0.0
      }
    },
    "additionalProperties": false
  },
  "execute": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "ExecuteMsg",
    "oneOf": [
      {
        "description": "List a product SKU with initial stock and unit price. Caller becomes `seller`. Admin may also list.",
        "type": "object",
        "required": [
          "list_product"
        ],
        "properties": {
          "list_product": {
            "type": "object",
            "required": [
              "sku",
              "stock",
              "unit_price"
            ],
            "properties": {
              "content_cid": {
                "description": "Prefer bare sha256 hex (BUD primary). See hash-market `content-distribution.md`.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "d_tag": {
                "description": "Optional NIP-15 product d-tag for Nostr mirror.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "sku": {
                "type": "string"
              },
              "stock": {
                "type": "integer",
                "format": "uint64",
                "minimum": 0.0
              },
              "unit_price": {
                "$ref": "#/definitions/Uint128"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      {
        "description": "Seller or admin: set absolute stock. Cannot go below reserved qty.",
        "type": "object",
        "required": [
          "update_stock"
        ],
        "properties": {
          "update_stock": {
            "type": "object",
            "required": [
              "sku",
              "stock"
            ],
            "properties": {
              "sku": {
                "type": "string"
              },
              "stock": {
                "type": "integer",
                "format": "uint64",
                "minimum": 0.0
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      {
        "description": "Buyer: pay ≥ unit_price * qty in accepted_denom. Creates a Reserved order; inventory reserved until settle/cancel.",
        "type": "object",
        "required": [
          "purchase"
        ],
        "properties": {
          "purchase": {
            "type": "object",
            "required": [
              "qty",
              "sku"
            ],
            "properties": {
              "qty": {
                "type": "integer",
                "format": "uint64",
                "minimum": 0.0
              },
              "sku": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      {
        "description": "Anyone: settle after buffer. Pays seller (minus optional fee), decrements stock.",
        "type": "object",
        "required": [
          "settle"
        ],
        "properties": {
          "settle": {
            "type": "object",
            "required": [
              "order_id"
            ],
            "properties": {
              "order_id": {
                "type": "integer",
                "format": "uint64",
                "minimum": 0.0
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      {
        "description": "Buyer or admin only: cancel while Reserved; refund + release reservation. Seller cannot cancel (prevents grief during buffer escrow).",
        "type": "object",
        "required": [
          "cancel"
        ],
        "properties": {
          "cancel": {
            "type": "object",
            "required": [
              "order_id"
            ],
            "properties": {
              "order_id": {
                "type": "integer",
                "format": "uint64",
                "minimum": 0.0
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      {
        "description": "Admin only: flip ingress auto-execute policy. Default remains off. Does not cause the contract to pull Nostr events.",
        "type": "object",
        "required": [
          "set_auto_execute_ingress"
        ],
        "properties": {
          "set_auto_execute_ingress": {
            "type": "object",
            "required": [
              "enabled"
            ],
            "properties": {
              "enabled": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    ],
    "definitions": {
      "Uint128": {
        "description": "A thin wrapper around u128 that is using strings for JSON encoding/decoding, such that the full u128 range can be used for clients that convert JSON numbers to floats, like JavaScript and jq.\n\n# Examples\n\nUse `from` to create instances of this and `u128` to get the value out:\n\n``` # use cosmwasm_std::Uint128; let a = Uint128::from(123u128); assert_eq!(a.u128(), 123);\n\nlet b = Uint128::from(42u64); assert_eq!(b.u128(), 42);\n\nlet c = Uint128::from(70u32); assert_eq!(c.u128(), 70); ```",
        "type": "string"
      }
    }
  },
  "query": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "QueryMsg",
    "oneOf": [
      {
        "type": "object",
