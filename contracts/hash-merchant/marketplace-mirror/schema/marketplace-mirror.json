  "sudo": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "SudoMsg",
    "description": "Matches module JSON: `{\"hash_merchant\":{...}}` (loyalty-verifier / hashmerchant-test).",
    "oneOf": [
      {
        "type": "object",
        "required": [
          "hash_merchant"
        ],
        "properties": {
          "hash_merchant": {
            "type": "object",
            "required": [
              "algo",
              "chain_uid",
              "height",
              "root"
            ],
            "properties": {
              "algo": {
                "type": "string"
              },
              "attestation_count": {
                "default": 0,
                "type": "integer",
                "format": "uint32",
                "minimum": 0.0
              },
              "block_time": {
                "default": 0,
                "type": "integer",
                "format": "int64"
              },
              "chain_uid": {
                "type": "string"
              },
              "height": {
                "type": "integer",
                "format": "uint64",
                "minimum": 0.0
              },
              "root": {
                "description": "Base64-encoded root bytes from the module (or passthrough hex).",
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    ]
  },
