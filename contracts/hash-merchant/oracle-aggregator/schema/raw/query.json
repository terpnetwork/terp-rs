            "market_id",
            "window"
          ],
          "properties": {
            "market_id": {
              "type": "string"
            },
            "window": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0.0
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  ]
}
