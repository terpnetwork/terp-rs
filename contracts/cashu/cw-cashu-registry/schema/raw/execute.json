{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ExecuteMsg",
  "oneOf": [
    {
      "description": "Insert a mint descriptor. Rejects duplicate mint_id or normalized url. Admin always; anyone when `allow_public_register`.",
      "type": "object",
      "required": [
        "register_mint"
      ],
      "properties": {
        "register_mint": {
          "type": "object",
          "required": [
            "url"
          ],
          "properties": {
            "content_sha256": {
              "type": [
                "string",
                "null"
              ]
            },
            "keyset_ids": {
              "default": [],
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "metadata": {
              "default": {},
              "type": "object",
              "additionalProperties": false
            },
            "mint_id": {
              "description": "Optional override. Empty/None → `hex(sha256(normalize_url(url)))`.",
              "type": [
                "string",
                "null"
              ]
            },
            "name": {
              "type": [
                "string",
                "null"
              ]
            },
            "nuts": {
              "default": {},
              "type": "object",
              "additionalProperties": false
            },
            "pubkey": {
              "type": [
                "string",
                "null"
              ]
            },
            "status": {
              "description": "Defaults to `active` when omitted.",
              "anyOf": [
                {
                  "$ref": "#/definitions/MintStatus"
                },
                {
                  "type": "null"
                }
              ]
            },
            "units": {
              "default": [],
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "url": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Patch mutable fields. Admin or original registrar.",
      "type": "object",
      "required": [
        "update_mint"
      ],
      "properties": {
        "update_mint": {
          "type": "object",
          "required": [
            "mint_id"
          ],
          "properties": {
            "content_sha256": {
              "type": [
                "string",
                "null"
              ]
            },
            "keyset_ids": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "string"
              }
            },
            "metadata": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": false
            },
            "mint_id": {
              "type": "string"
            },
            "name": {
              "type": [
                "string",
                "null"
              ]
            },
            "nuts": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": false
            },
            "pubkey": {
              "type": [
                "string",
                "null"
              ]
            },
            "units": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "string"
              }
            },
            "url": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Admin only: set discovery status.",
      "type": "object",
      "required": [
        "set_status"
      ],
      "properties": {
        "set_status": {
          "type": "object",
          "required": [
            "mint_id",
            "status"
          ],
          "properties": {
            "mint_id": {
              "type": "string"
            },
            "status": {
              "$ref": "#/definitions/MintStatus"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Admin only: soft-revoke (status = revoked). Keeps row for audit.",
      "type": "object",
      "required": [
        "remove_mint"
      ],
      "properties": {
        "remove_mint": {
          "type": "object",
          "required": [
            "mint_id"
          ],
          "properties": {
            "mint_id": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Admin only: update config / transfer admin.",
      "type": "object",
      "required": [
        "update_config"
      ],
      "properties": {
        "update_config": {
          "type": "object",
          "properties": {
            "admin": {
              "type": [
                "string",
                "null"
              ]
            },
            "allow_public_register": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "max_metadata_bytes": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint32",
              "minimum": 0.0
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  ],
  "definitions": {
    "MintStatus": {
      "description": "Discovery status for a registered mint.",
      "oneOf": [
        {
          "description": "Discoverable; wallets may use subject to their own trust.",
          "type": "string",
          "enum": [
            "active"
          ]
        },
        {
          "description": "Temporarily hidden from default list queries.",
          "type": "string",
          "enum": [
            "paused"
          ]
        },
        {
          "description": "Tombstone; kept for audit, excluded from default list.",
          "type": "string",
          "enum": [
            "revoked"
          ]
        }
      ]
    }
  }
}
