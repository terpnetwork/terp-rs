{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ConsensusState",
  "type": "object",
  "required": [
    "kind",
    "proven_height",
    "proven_lanes",
    "proven_root_key",
    "version"
  ],
  "properties": {
    "kind": {
      "$ref": "#/definitions/ConsensusKind"
    },
    "proven_height": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    },
    "proven_lanes": {
      "type": "array",
      "items": {
        "type": "integer",
        "format": "uint32",
        "minimum": 0.0
      }
    },
    "proven_root_key": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "format": "uint8",
      "minimum": 0.0
    }
  },
  "additionalProperties": false,
  "definitions": {
    "ConsensusKind": {
      "type": "string",
      "enum": [
        "b"
      ]
    }
  }
}
