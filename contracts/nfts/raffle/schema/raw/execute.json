{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ExecuteMsg",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "create_raffle"
      ],
      "properties": {
        "create_raffle": {
          "type": "object",
          "required": [
            "assets",
            "raffle_options",
            "raffle_ticket_price"
          ],
          "properties": {
            "assets": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/AssetInfo"
              }
            },
            "owner": {
              "type": [
                "string",
                "null"
              ]
            },
            "raffle_options": {
              "$ref": "#/definitions/RaffleOptionsMsg"
            },
            "raffle_ticket_price": {
              "$ref": "#/definitions/AssetInfo"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "cancel_raffle"
      ],
      "properties": {
        "cancel_raffle": {
          "type": "object",
          "required": [
            "raffle_id"
          ],
          "properties": {
            "raffle_id": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0.0
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "buy_ticket"
      ],
      "properties": {
        "buy_ticket": {
          "type": "object",
          "required": [
            "raffle_id",
            "ticket_count"
          ],
          "properties": {
            "on_behalf_of": {
              "type": [
                "string",
                "null"
              ]
            },
            "raffle_id": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0.0
            },
            "ticket_count": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0.0
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "`Seed` source. `seed` is 32 bytes.",
      "type": "object",
      "required": [
        "draw"
      ],
      "properties": {
        "draw": {
          "type": "object",
          "required": [
            "raffle_id",
            "seed"
          ],
          "properties": {
            "raffle_id": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0.0
            },
            "seed": {
              "$ref": "#/definitions/Binary"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "`Callback` source. The verifier reply stores the seed.",
      "type": "object",
      "required": [
        "request_draw"
      ],
      "properties": {
        "request_draw": {
          "type": "object",
          "required": [
            "raffle_id"
          ],
          "properties": {
            "raffle_id": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0.0
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "claim_raffle"
      ],
      "properties": {
        "claim_raffle": {
          "type": "object",
          "required": [
            "raffle_id"
          ],
          "properties": {
            "raffle_id": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0.0
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "update_config"
      ],
      "properties": {
        "update_config": {
          "type": "object",
          "properties": {
            "creation_coins": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "$ref": "#/definitions/Coin"
              }
            },
            "fee_addr": {
              "type": [
                "string",
                "null"
              ]
            },
            "max_tickets_per_raffle": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint32",
              "minimum": 0.0
            },
            "minimum_raffle_duration": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint64",
              "minimum": 0.0
            },
            "owner": {
              "type": [
                "string",
                "null"
              ]
            },
            "raffle_fee": {
              "anyOf": [
                {
                  "$ref": "#/definitions/Decimal"
                },
                {
                  "type": "null"
                }
              ]
            },
            "randomness": {
              "anyOf": [
                {
                  "$ref": "#/definitions/RandomnessSourceMsg"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "toggle_lock"
      ],
      "properties": {
        "toggle_lock": {
          "type": "object",
          "required": [
            "lock"
          ],
          "properties": {
            "lock": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Owner: set or clear oracle pricing. `None` clears it.",
      "type": "object",
      "required": [
        "update_oracle_pricing"
      ],
      "properties": {
        "update_oracle_pricing": {
          "type": "object",
          "properties": {
            "pricing": {
              "anyOf": [
                {
                  "$ref": "#/definitions/OraclePricing"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  ],
  "definitions": {
    "AggregateMethod": {
      "description": "How several values are combined into one.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "median",
            "min",
            "max"
          ]
        },
        {
          "description": "Weighted by `Feed::weight` (default 1) when combining feeds, and by nothing when combining a history window.",
          "type": "string",
          "enum": [
            "mean"
          ]
        },
        {
          "description": "Weighted by observation count (`PricePoint::observations`) when combining feeds, and by block gap (piecewise constant, like the registry TWAP) on a history window.",
          "type": "string",
          "enum": [
            "weighted"
          ]
        }
      ]
    },
    "AltAsset": {
      "description": "An alternate asset accepted in place of `base_denom`.",
      "type": "object",
      "required": [
        "alt_decimals",
        "asset",
        "base_decimals",
        "base_denom",
        "feeds",
        "quote"
      ],
      "properties": {
        "alt_decimals": {
          "description": "Decimals of the alt asset.",
          "type": "integer",
          "format": "uint8",
          "minimum": 0.0
        },
        "asset": {
          "$ref": "#/definitions/PriceAsset"
        },
        "base_decimals": {
          "description": "Decimals of the base denom (e.g. 6 for uterp).",
          "type": "integer",
          "format": "uint8",
          "minimum": 0.0
        },
        "base_denom": {
          "description": "The default mint asset this alt is priced against.",
          "type": "string"
        },
        "combine": {
          "description": "How feed values are combined. Default median.",
          "default": "median",
          "allOf": [
            {
              "$ref": "#/definitions/AggregateMethod"
            }
          ]
        },
        "feeds": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Feed"
          }
        },
        "quote": {
          "$ref": "#/definitions/Quote"
        }
      },
      "additionalProperties": false
    },
    "AssetInfo": {
      "description": "Prize, collateral, or ticket price.\n\nUpstream also had an `Sg721Token` arm. This port keeps cw721 only, which is the trait `cw721-svg` implements.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "coin"
          ],
          "properties": {
            "coin": {
              "$ref": "#/definitions/Coin"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "cw721"
          ],
          "properties": {
            "cw721": {
              "$ref": "#/definitions/Cw721Token"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "Binary": {
      "description": "Binary is a wrapper around Vec<u8> to add base64 de/serialization with serde. It also adds some helper methods to help encode inline.\n\nThis is only needed as serde-json-{core,wasm} has a horrible encoding for Vec<u8>. See also <https://github.com/CosmWasm/cosmwasm/blob/main/docs/MESSAGE_TYPES.md>.",
      "type": "string"
    },
    "Coin": {
      "type": "object",
      "required": [
        "amount",
        "denom"
      ],
      "properties": {
        "amount": {
          "$ref": "#/definitions/Uint256"
        },
        "denom": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "Cw721Token": {
      "description": "One cw721 token. `address` is stored in the form `Api::addr_validate` returns.",
      "type": "object",
      "required": [
        "address",
        "token_id"
      ],
      "properties": {
        "address": {
          "type": "string"
        },
        "token_id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "Decimal": {
      "description": "A fixed-point decimal value with 18 fractional digits, i.e. Decimal(1_000_000_000_000_000_000) == 1.0\n\nThe greatest possible value that can be represented is 340282366920938463463.374607431768211455 = (2^128 - 1) / 10^18",
      "type": "string"
    },
    "Feed": {
      "description": "One oracle source.",
      "type": "object",
      "required": [
        "kind",
        "oracle"
      ],
      "properties": {
        "kind": {
          "$ref": "#/definitions/FeedKind"
        },
        "oracle": {
          "description": "Oracle contract address (registry, aggregator or probe, matching `kind`).",
          "type": "string"
        },
        "weight": {
          "description": "Weight for `AggregateMethod::Mean` across feeds. Default 1.",
          "default": null,
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    },
    "FeedKind": {
      "description": "What to read from one oracle contract.",
      "oneOf": [
        {
          "description": "Registry `Latest { market_id }`.",
          "type": "object",
          "required": [
            "spot"
          ],
          "properties": {
            "spot": {
              "type": "object",
              "required": [
                "market_id"
              ],
              "properties": {
                "market_id": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        {
          "description": "Registry `Twap` over the newest `window_blocks` heights ending at the latest observation.",
          "type": "object",
          "required": [
            "twap"
          ],
          "properties": {
            "twap": {
              "type": "object",
              "required": [
                "market_id",
                "window_blocks"
              ],
              "properties": {
                "market_id": {
                  "type": "string"
                },
                "window_blocks": {
                  "type": "integer",
                  "format": "uint64",
                  "minimum": 0.0
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        {
          "description": "Registry `History { limit }`, combined locally with `method`.",
          "type": "object",
          "required": [
            "history"
          ],
          "properties": {
            "history": {
              "type": "object",
              "required": [
                "limit",
                "market_id",
                "method"
              ],
              "properties": {
                "limit": {
                  "type": "integer",
                  "format": "uint32",
                  "minimum": 0.0
                },
                "market_id": {
                  "type": "string"
                },
                "method": {
                  "$ref": "#/definitions/AggregateMethod"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        {
          "description": "Aggregator `Median { market_id, window }`. The height comes from the aggregator's registry `Latest`, so staleness checks still apply.",
          "type": "object",
          "required": [
            "aggregator_median"
          ],
          "properties": {
            "aggregator_median": {
              "type": "object",
              "required": [
                "market_id",
                "window"
              ],
              "properties": {
                "market_id": {
                  "type": "string"
                },
                "window": {
                  "type": "integer",
                  "format": "uint32",
                  "minimum": 0.0
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        {
          "description": "TWAP probe `ArithmeticTwap { pool_id }`. Carries no height.",
          "type": "object",
          "required": [
            "probe_twap"
          ],
          "properties": {
            "probe_twap": {
              "type": "object",
              "required": [
                "pool_id"
              ],
              "properties": {
                "pool_id": {
                  "type": "integer",
                  "format": "uint64",
                  "minimum": 0.0
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "OraclePricing": {
      "description": "Optional oracle pricing for a minting contract.\n\nAbsent, or `enforce == false`: only the default asset is accepted and payment behaves as before. The oracle queries still answer, so a frontend can show prices before enforcement is switched on.",
      "type": "object",
      "required": [
        "alt_assets",
        "enforce"
      ],
      "properties": {
        "alt_assets": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/AltAsset"
          }
        },
        "enforce": {
          "type": "boolean"
        },
        "policy": {
          "default": {
            "max_deviation": null,
            "max_staleness_blocks": null,
            "min_observations": null,
            "min_sources": null,
            "slippage": null
          },
          "allOf": [
            {
              "$ref": "#/definitions/PricingPolicy"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "PriceAsset": {
      "description": "An asset priced by the oracle: a native/IBC/factory denom or a cw20 address.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "native"
          ],
          "properties": {
            "native": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "cw20"
          ],
          "properties": {
            "cw20": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "PricingPolicy": {
      "description": "Guards applied to every price read.",
      "type": "object",
      "properties": {
        "max_deviation": {
          "description": "Max relative spread between any feed and the combined price, e.g. 0.05.",
          "default": null,
          "anyOf": [
            {
              "$ref": "#/definitions/Decimal"
            },
            {
              "type": "null"
            }
          ]
        },
        "max_staleness_blocks": {
          "description": "Max `env.block.height - observation.height`. Requires feeds that record local (terp) heights. `None` disables the check.",
          "default": null,
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "min_observations": {
          "description": "Min total observations behind the combined price. Default none.",
          "default": null,
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0.0
        },
        "min_sources": {
          "description": "Min number of feeds that must answer. Default 1.",
          "default": null,
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0.0
        },
        "slippage": {
          "description": "Accepted underpayment against the quote, e.g. 0.01 = pay at least 99%. Overpayment is refunded.",
          "default": null,
          "anyOf": [
            {
              "$ref": "#/definitions/Decimal"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "Quote": {
      "description": "Direction of the feed price.",
      "oneOf": [
        {
          "description": "Feed value = base units per 1 alt (in display units). E.g. feed `ATOM/TERP = 12.5`, base TERP, alt ATOM: 1 ATOM costs 12.5 TERP.",
          "type": "string",
          "enum": [
            "alt_in_base"
          ]
        },
        {
          "description": "Feed value = alt units per 1 base (in display units).",
          "type": "string",
          "enum": [
            "base_in_alt"
          ]
        }
      ]
    },
    "RaffleOptionsMsg": {
      "type": "object",
      "required": [
        "duration",
        "one_winner_per_asset"
      ],
      "properties": {
        "comment": {
          "type": [
            "string",
            "null"
          ]
        },
        "duration": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "max_ticket_number": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0.0
        },
        "max_ticket_per_address": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0.0
        },
        "min_ticket_number": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0.0
        },
        "one_winner_per_asset": {
          "description": "When set, one distinct ticket wins each asset, capped by the number of tickets.",
          "type": "boolean"
        },
        "start": {
          "description": "Defaults to the current block time.",
          "anyOf": [
            {
              "$ref": "#/definitions/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "RandomnessSourceMsg": {
      "oneOf": [
        {
          "description": "`provider` is the only account allowed to submit a seed. `None` accepts a seed from any account. Use that for tests.",
          "type": "object",
          "required": [
            "seed"
          ],
          "properties": {
            "seed": {
              "type": "object",
              "properties": {
                "provider": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        {
          "description": "External verifier. See [`VerifierExecuteMsg`].",
          "type": "object",
          "required": [
            "callback"
          ],
          "properties": {
            "callback": {
              "type": "object",
              "required": [
                "verifier"
              ],
              "properties": {
                "verifier": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "Timestamp": {
      "description": "A point in time in nanosecond precision.\n\nThis type can represent times from 1970-01-01T00:00:00Z to 2554-07-21T23:34:33Z.\n\n## Examples\n\n``` # use cosmwasm_std::Timestamp; let ts = Timestamp::from_nanos(1_000_000_202); assert_eq!(ts.nanos(), 1_000_000_202); assert_eq!(ts.seconds(), 1); assert_eq!(ts.subsec_nanos(), 202);\n\nlet ts = ts.plus_seconds(2); assert_eq!(ts.nanos(), 3_000_000_202); assert_eq!(ts.seconds(), 3); assert_eq!(ts.subsec_nanos(), 202); ```",
      "allOf": [
        {
          "$ref": "#/definitions/Uint64"
        }
      ]
    },
    "Uint256": {
      "description": "An implementation of u256 that is using strings for JSON encoding/decoding, such that the full u256 range can be used for clients that convert JSON numbers to floats, like JavaScript and jq.\n\n# Examples\n\nUse `new` to create instances out of u128, `from` for other primitive uint types or `from_be_bytes` to provide big endian bytes:\n\n``` # use cosmwasm_std::Uint256; let a = Uint256::new(258u128); let b = Uint256::from(258u16); let c = Uint256::from_be_bytes([ 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 1u8, 2u8, ]); assert_eq!(a, b); assert_eq!(a, c); ```",
      "type": "string"
    },
    "Uint64": {
      "description": "A thin wrapper around u64 that is using strings for JSON encoding/decoding, such that the full u64 range can be used for clients that convert JSON numbers to floats, like JavaScript and jq.\n\n# Examples\n\nUse `from` to create instances of this and `u64` to get the value out:\n\n``` # use cosmwasm_std::Uint64; let a = Uint64::from(42u64); assert_eq!(a.u64(), 42);\n\nlet b = Uint64::from(70u32); assert_eq!(b.u64(), 70); ```",
      "type": "string"
    }
  }
}
