          "fee_payer",
          "msg",
          "msg_index",
          "sign_mode_tx_data",
          "signature",
          "signature_data",
          "simulate",
          "tx_data"
        ],
        "properties": {
          "account": {
            "$ref": "#/definitions/Addr"
          },
          "authenticator_id": {
            "type": "string"
          },
          "authenticator_params": {
            "anyOf": [
