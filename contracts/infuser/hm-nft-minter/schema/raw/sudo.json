{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SudoMsg",
  "description": "Module sudo envelope (struct form — matches Go JSON, not Rust enum).",
  "type": "object",
  "required": [
    "hash_merchant"
  ],
  "properties": {
    "hash_merchant": {
      "$ref": "#/definitions/HashMerchantSudoPayload"
    }
  },
  "additionalProperties": false,
  "definitions": {
    "Binary": {
      "description": "Binary is a wrapper around Vec<u8> to add base64 de/serialization with serde. It also adds some helper methods to help encode inline.\n\nThis is only needed as serde-json-{core,wasm} has a horrible encoding for Vec<u8>. See also <https://github.com/CosmWasm/cosmwasm/blob/main/docs/MESSAGE_TYPES.md>.",
      "type": "string"
    },
    "HashMerchantSudoOracleAttestation": {
      "type": "object",
      "required": [
        "height",
        "source_id",
        "value"
      ],
      "properties": {
        "height": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "source_id": {
          "type": "string"
        },
        "value": {
          "description": "Opaque value bytes; price demos use JSON UTF-8.",
          "allOf": [
            {
              "$ref": "#/definitions/Binary"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "HashMerchantSudoPayload": {
      "type": "object",
      "required": [
        "algo",
        "attestation_count",
        "block_time",
        "chain_uid",
        "height",
        "root"
      ],
      "properties": {
        "algo": {
          "type": "string"
        },
        "attestation_count": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "block_time": {
          "type": "integer",
          "format": "int64"
        },
        "chain_uid": {
          "type": "string"
        },
        "height": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "oracle_sources": {
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/definitions/HashMerchantSudoOracleAttestation"
          }
        },
        "root": {
          "description": "Confirmed root bytes (base64 in JSON).",
          "allOf": [
            {
              "$ref": "#/definitions/Binary"
            }
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
