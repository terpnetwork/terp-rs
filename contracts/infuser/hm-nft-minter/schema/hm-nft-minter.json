{
  "contract_name": "hm-nft-minter",
  "contract_version": "0.0.2",
  "idl_version": "1.0.0",
  "instantiate": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "InstantiateMsg",
    "type": "object",
    "required": [
      "max_tokens",
      "price",
      "whitelist"
    ],
    "properties": {
      "cw721_address": {
        "description": "Existing CW721 (e.g. cw721-svg) address where this minter is authorized. If None, admin must call `LinkCollection` before mint.",
        "type": [
          "string",
          "null"
        ]
      },
      "max_tokens": {
        "description": "Hard supply cap. Oracle/sudo can NEVER increase this.",
        "type": "integer",
        "format": "uint32",
        "minimum": 0.0
      },
      "owner": {
        "description": "Optional owner (defaults to sender).",
        "type": [
          "string",
          "null"
        ]
      },
      "paused": {
        "description": "Start paused (default false).",
        "type": [
          "boolean",
          "null"
        ]
      },
      "price": {
        "description": "Oracle / fixed price policy.",
        "allOf": [
          {
            "$ref": "#/definitions/PricePolicy"
          }
        ]
      },
      "proceeds": {
        "description": "Address that receives mint proceeds (defaults to owner).",
        "type": [
          "string",
          "null"
        ]
      },
      "token_uri_prefix": {
        "description": "Base token URI / template prefix (collection-specific; optional).",
        "type": [
          "string",
          "null"
        ]
      },
      "whitelist": {
        "description": "Whitelist gate (hm-loyalty/v1).",
        "allOf": [
          {
            "$ref": "#/definitions/WhitelistConfig"
          }
        ]
      }
    },
    "additionalProperties": false,
    "definitions": {
      "PricePolicy": {
        "description": "Admin / instantiate price policy.",
        "type": "object",
        "required": [
          "bps_band",
          "denom",
          "enabled",
          "max_staleness_seconds",
          "mode"
        ],
        "properties": {
          "algo": {
            "description": "Optional filter: only accept sudo for this algo.",
            "type": [
              "string",
              "null"
            ]
          },
          "asset_id": {
            "description": "Optional asset filter when decoding JSON price payloads (`asset` field).",
            "type": [
              "string",
              "null"
            ]
          },
          "bps_band": {
            "description": "Half-width band in basis points around mid. 0 = exact mid only. Payment must satisfy mid * (1 - bps/10000) ..= mid * (1 + bps/10000).",
            "type": "integer",
            "format": "uint16",
            "minimum": 0.0
          },
          "chain_uid": {
            "description": "Optional filter: only accept sudo for this chain_uid.",
            "type": [
              "string",
              "null"
            ]
          },
          "denom": {
            "description": "Payment denom (e.g. `uterp`).",
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          },
          "fallback_unit_price": {
            "description": "When oracle disabled or mid absent: fixed unit price in `denom` microunits.",
            "anyOf": [
              {
                "$ref": "#/definitions/Uint128"
              },
              {
                "type": "null"
              }
            ]
          },
          "max_staleness_seconds": {
            "description": "Fail closed when mid is older than this many seconds (vs `env.block.time`).",
            "type": "integer",
            "format": "uint64",
            "minimum": 0.0
          },
          "mode": {
            "$ref": "#/definitions/PriceSyncMode"
          },
          "usd_to_unit_scale": {
            "description": "If attestation has `price_usd` (decimal string) and no direct mid, mid = round(price_usd * usd_to_unit_scale). Demo FX only.",
            "anyOf": [
              {
                "$ref": "#/definitions/Uint128"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false
      },
      "PriceSyncMode": {
        "description": "How the minter obtains price mids.",
        "oneOf": [
          {
            "description": "Mode A: x/hashmerchant sudo push (preferred long-term).",
            "type": "string",
            "enum": [
              "sudo"
            ]
          },
          {
            "description": "Mode B: pull/query another store (stub for frameworks; not required in v0 minter).",
            "type": "string",
            "enum": [
              "query"
            ]
          },
          {
            "description": "Mode C: admin ExecuteMsg sync (demo fallback only).",
            "type": "string",
            "enum": [
              "admin_sync"
            ]
          }
        ]
      },
      "Uint128": {
        "description": "A thin wrapper around u128 that is using strings for JSON encoding/decoding, such that the full u128 range can be used for clients that convert JSON numbers to floats, like JavaScript and jq.\n\n# Examples\n\nUse `from` to create instances of this and `u128` to get the value out:\n\n``` # use cosmwasm_std::Uint128; let a = Uint128::from(123u128); assert_eq!(a.u128(), 123);\n\nlet b = Uint128::from(42u64); assert_eq!(b.u128(), 42);\n\nlet c = Uint128::from(70u32); assert_eq!(c.u128(), 70); ```",
        "type": "string"
      },
      "WhitelistConfig": {
        "description": "Config snapshot for a minter that gates on loyalty eligibility.",
        "type": "object",
        "required": [
          "codec",
          "enabled"
        ],
        "properties": {
          "codec": {
            "description": "Codec version currently accepted (e.g. `hm-loyalty/v1`).",
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          },
          "root": {
            "description": "32-byte merkle root as lowercase hex (empty if not set).",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "execute": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "ExecuteMsg",
    "oneOf": [
      {
        "description": "Mint next token to sender if whitelist + price checks pass.",
        "type": "object",
        "required": [
          "mint"
        ],
        "properties": {
          "mint": {
            "type": "object",
            "properties": {
              "proof": {
                "description": "Merkle proof when whitelist.enabled.",
                "anyOf": [
                  {
                    "$ref": "#/definitions/LoyaltyProof"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "token_uri": {
                "description": "Optional token_uri override; otherwise `{prefix}{token_id}`.",
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      {
        "description": "Admin: set loyalty root + codec.",
        "type": "object",
        "required": [
          "set_whitelist_root"
        ],
        "properties": {
          "set_whitelist_root": {
            "type": "object",
            "required": [
              "root"
            ],
            "properties": {
              "codec": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "enabled": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "root": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      {
        "description": "Admin: update price policy (bps, staleness, fallback, filters).",
        "type": "object",
        "required": [
          "set_price_policy"
        ],
        "properties": {
          "set_price_policy": {
            "type": "object",
            "required": [
              "price"
            ],
            "properties": {
              "price": {
                "$ref": "#/definitions/PricePolicy"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      {
        "description": "Mode C only: admin-pushed mid (demo fallback).",
        "type": "object",
        "required": [
          "admin_sync_price"
        ],
        "properties": {
          "admin_sync_price": {
            "type": "object",
            "required": [
              "mid"
            ],
            "properties": {
              "asset_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "foreign_height": {
                "type": [
                  "integer",
                  "null"
                ],
                "format": "uint64",
                "minimum": 0.0
              },
              "mid": {
                "$ref": "#/definitions/Uint128"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      {
        "description": "Admin: attach CW721 collection (once).",
        "type": "object",
        "required": [
          "link_collection"
        ],
        "properties": {
          "link_collection": {
            "type": "object",
            "required": [
              "cw721_address"
            ],
            "properties": {
              "cw721_address": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      {
        "description": "Admin: pause/unpause minting.",
        "type": "object",
        "required": [
          "set_paused"
        ],
        "properties": {
          "set_paused": {
            "type": "object",
            "required": [
              "paused"
            ],
            "properties": {
              "paused": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      {
        "description": "Admin: update proceeds recipient.",
        "type": "object",
        "required": [
          "set_proceeds"
        ],
        "properties": {
          "set_proceeds": {
            "type": "object",
            "required": [
              "proceeds"
            ],
            "properties": {
              "proceeds": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      {
        "description": "Owner: withdraw native proceeds to `proceeds` (or specified recipient).",
        "type": "object",
        "required": [
          "withdraw"
        ],
        "properties": {
          "withdraw": {
            "type": "object",
            "properties": {
              "amount": {
                "anyOf": [
                  {
                    "$ref": "#/definitions/Uint128"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      {
        "description": "cw-ownable ownership update.",
        "type": "object",
        "required": [
          "update_ownership"
        ],
        "properties": {
          "update_ownership": {
            "$ref": "#/definitions/Action"
          }
        },
        "additionalProperties": false
      }
    ],
    "definitions": {
      "Action": {
        "description": "Actions that can be taken to alter the contract's ownership",
        "oneOf": [
          {
            "description": "Propose to transfer the contract's ownership to another account, optionally with an expiry time.\n\nCan only be called by the contract's current owner.\n\nAny existing pending ownership transfer is overwritten.",
            "type": "object",
            "required": [
              "transfer_ownership"
            ],
            "properties": {
              "transfer_ownership": {
                "type": "object",
                "required": [
                  "new_owner"
                ],
                "properties": {
                  "expiry": {
                    "anyOf": [
                      {
                        "$ref": "#/definitions/Expiration"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "new_owner": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          {
            "description": "Accept the pending ownership transfer.\n\nCan only be called by the pending owner.",
            "type": "string",
            "enum": [
              "accept_ownership"
            ]
          },
          {
            "description": "Give up the contract's ownership and the possibility of appointing a new owner.\n\nCan only be invoked by the contract's current owner.\n\nAny existing pending ownership transfer is canceled.",
            "type": "string",
            "enum": [
              "renounce_ownership"
            ]
          }
        ]
      },
      "Expiration": {
        "description": "Expiration represents a point in time when some event happens. It can compare with a BlockInfo and will return is_expired() == true once the condition is hit (and for every block in the future)",
        "oneOf": [
          {
            "description": "AtHeight will expire when `env.block.height` >= height",
            "type": "object",
            "required": [
              "at_height"
            ],
            "properties": {
              "at_height": {
                "type": "integer",
                "format": "uint64",
                "minimum": 0.0
              }
            },
            "additionalProperties": false
          },
          {
            "description": "AtTime will expire when `env.block.time` >= time",
            "type": "object",
            "required": [
              "at_time"
            ],
            "properties": {
              "at_time": {
                "$ref": "#/definitions/Timestamp"
              }
            },
            "additionalProperties": false
          },
          {
            "description": "Never will never expire. Used to express the empty variant",
            "type": "object",
            "required": [
              "never"
            ],
            "properties": {
              "never": {
                "type": "object",
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        ]
      },
      "LoyaltyProof": {
        "description": "On-chain / client proof payload (hex-encoded siblings + root).",
        "type": "object",
        "required": [
          "address",
          "codec",
          "proof"
        ],
        "properties": {
          "address": {
            "description": "Bech32 (or chain) address that was hashed into the leaf.",
            "type": "string"
          },
          "codec": {
            "description": "Must equal [`CODEC_V1`] for v1 verifiers.",
            "type": "string"
          },
          "leaf": {
            "description": "Optional precomputed leaf hex; recomputed from address if omitted.",
            "type": [
              "string",
              "null"
            ]
          },
          "proof": {
            "description": "Sibling hashes, bottom-up (hex).",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "root": {
            "description": "Expected root hex (optional cross-check against stored root).",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      },
      "PricePolicy": {
        "description": "Admin / instantiate price policy.",
        "type": "object",
        "required": [
          "bps_band",
          "denom",
          "enabled",
          "max_staleness_seconds",
          "mode"
        ],
        "properties": {
          "algo": {
            "description": "Optional filter: only accept sudo for this algo.",
            "type": [
              "string",
              "null"
            ]
          },
          "asset_id": {
            "description": "Optional asset filter when decoding JSON price payloads (`asset` field).",
            "type": [
              "string",
              "null"
            ]
          },
          "bps_band": {
            "description": "Half-width band in basis points around mid. 0 = exact mid only. Payment must satisfy mid * (1 - bps/10000) ..= mid * (1 + bps/10000).",
            "type": "integer",
            "format": "uint16",
            "minimum": 0.0
          },
          "chain_uid": {
            "description": "Optional filter: only accept sudo for this chain_uid.",
            "type": [
              "string",
              "null"
            ]
          },
          "denom": {
            "description": "Payment denom (e.g. `uterp`).",
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          },
          "fallback_unit_price": {
            "description": "When oracle disabled or mid absent: fixed unit price in `denom` microunits.",
            "anyOf": [
              {
                "$ref": "#/definitions/Uint128"
              },
              {
                "type": "null"
              }
            ]
          },
          "max_staleness_seconds": {
            "description": "Fail closed when mid is older than this many seconds (vs `env.block.time`).",
            "type": "integer",
            "format": "uint64",
            "minimum": 0.0
          },
          "mode": {
            "$ref": "#/definitions/PriceSyncMode"
          },
          "usd_to_unit_scale": {
            "description": "If attestation has `price_usd` (decimal string) and no direct mid, mid = round(price_usd * usd_to_unit_scale). Demo FX only.",
            "anyOf": [
              {
                "$ref": "#/definitions/Uint128"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false
      },
      "PriceSyncMode": {
        "description": "How the minter obtains price mids.",
        "oneOf": [
          {
            "description": "Mode A: x/hashmerchant sudo push (preferred long-term).",
            "type": "string",
            "enum": [
              "sudo"
            ]
          },
          {
            "description": "Mode B: pull/query another store (stub for frameworks; not required in v0 minter).",
            "type": "string",
            "enum": [
              "query"
            ]
          },
          {
            "description": "Mode C: admin ExecuteMsg sync (demo fallback only).",
            "type": "string",
            "enum": [
              "admin_sync"
            ]
          }
        ]
      },
      "Timestamp": {
        "description": "A point in time in nanosecond precision.\n\nThis type can represent times from 1970-01-01T00:00:00Z to 2554-07-21T23:34:33Z.\n\n## Examples\n\n``` # use cosmwasm_std::Timestamp; let ts = Timestamp::from_nanos(1_000_000_202); assert_eq!(ts.nanos(), 1_000_000_202); assert_eq!(ts.seconds(), 1); assert_eq!(ts.subsec_nanos(), 202);\n\nlet ts = ts.plus_seconds(2); assert_eq!(ts.nanos(), 3_000_000_202); assert_eq!(ts.seconds(), 3); assert_eq!(ts.subsec_nanos(), 202); ```",
        "allOf": [
          {
            "$ref": "#/definitions/Uint64"
          }
        ]
      },
      "Uint128": {
        "description": "A thin wrapper around u128 that is using strings for JSON encoding/decoding, such that the full u128 range can be used for clients that convert JSON numbers to floats, like JavaScript and jq.\n\n# Examples\n\nUse `from` to create instances of this and `u128` to get the value out:\n\n``` # use cosmwasm_std::Uint128; let a = Uint128::from(123u128); assert_eq!(a.u128(), 123);\n\nlet b = Uint128::from(42u64); assert_eq!(b.u128(), 42);\n\nlet c = Uint128::from(70u32); assert_eq!(c.u128(), 70); ```",
        "type": "string"
      },
      "Uint64": {
        "description": "A thin wrapper around u64 that is using strings for JSON encoding/decoding, such that the full u64 range can be used for clients that convert JSON numbers to floats, like JavaScript and jq.\n\n# Examples\n\nUse `from` to create instances of this and `u64` to get the value out:\n\n``` # use cosmwasm_std::Uint64; let a = Uint64::from(42u64); assert_eq!(a.u64(), 42);\n\nlet b = Uint64::from(70u32); assert_eq!(b.u64(), 70); ```",
        "type": "string"
      }
    }
  },
  "query": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "QueryMsg",
    "oneOf": [
      {
        "type": "object",
        "required": [
          "config"
        ],
        "properties": {
          "config": {
            "type": "object",
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      {
        "type": "object",
        "required": [
          "mint_price_bound"
        ],
        "properties": {
          "mint_price_bound": {
            "type": "object",
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      {
        "type": "object",
        "required": [
          "whitelist_root"
        ],
        "properties": {
          "whitelist_root": {
            "type": "object",
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      {
        "type": "object",
        "required": [
          "is_eligible"
        ],
        "properties": {
          "is_eligible": {
            "type": "object",
            "required": [
              "address",
              "proof"
            ],
            "properties": {
              "address": {
                "type": "string"
              },
              "proof": {
                "$ref": "#/definitions/LoyaltyProof"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      {
        "type": "object",
        "required": [
          "next_token_id"
        ],
        "properties": {
          "next_token_id": {
            "type": "object",
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      {
        "type": "object",
        "required": [
          "oracle_mid"
        ],
        "properties": {
          "oracle_mid": {
            "type": "object",
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      {
        "type": "object",
        "required": [
          "ownership"
        ],
        "properties": {
          "ownership": {
            "type": "object",
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    ],
    "definitions": {
      "LoyaltyProof": {
        "description": "On-chain / client proof payload (hex-encoded siblings + root).",
        "type": "object",
        "required": [
          "address",
          "codec",
          "proof"
        ],
        "properties": {
          "address": {
            "description": "Bech32 (or chain) address that was hashed into the leaf.",
            "type": "string"
          },
          "codec": {
            "description": "Must equal [`CODEC_V1`] for v1 verifiers.",
            "type": "string"
          },
          "leaf": {
            "description": "Optional precomputed leaf hex; recomputed from address if omitted.",
            "type": [
              "string",
              "null"
            ]
          },
          "proof": {
            "description": "Sibling hashes, bottom-up (hex).",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "root": {
            "description": "Expected root hex (optional cross-check against stored root).",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "migrate": null,
  "sudo": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "SudoMsg",
    "description": "Module sudo envelope (struct form — matches Go JSON, not Rust enum).",
    "type": "object",
    "required": [
      "hash_merchant"
    ],
    "properties": {
      "hash_merchant": {
        "$ref": "#/definitions/HashMerchantSudoPayload"
      }
    },
    "additionalProperties": false,
    "definitions": {
      "Binary": {
        "description": "Binary is a wrapper around Vec<u8> to add base64 de/serialization with serde. It also adds some helper methods to help encode inline.\n\nThis is only needed as serde-json-{core,wasm} has a horrible encoding for Vec<u8>. See also <https://github.com/CosmWasm/cosmwasm/blob/main/docs/MESSAGE_TYPES.md>.",
        "type": "string"
      },
      "HashMerchantSudoOracleAttestation": {
        "type": "object",
        "required": [
          "height",
          "source_id",
          "value"
        ],
        "properties": {
          "height": {
            "type": "integer",
            "format": "uint64",
            "minimum": 0.0
          },
          "source_id": {
            "type": "string"
          },
          "value": {
            "description": "Opaque value bytes; price demos use JSON UTF-8.",
            "allOf": [
              {
                "$ref": "#/definitions/Binary"
              }
            ]
          }
        },
        "additionalProperties": false
      },
      "HashMerchantSudoPayload": {
        "type": "object",
        "required": [
          "algo",
          "attestation_count",
          "block_time",
          "chain_uid",
          "height",
          "root"
        ],
        "properties": {
          "algo": {
            "type": "string"
          },
          "attestation_count": {
