    "list_svg_collections_by_creator": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Array_of_SvgCollection",
      "type": "array",
      "items": {
        "$ref": "#/definitions/SvgCollection"
      },
      "definitions": {
        "SvgCollection": {
          "type": "object",
          "required": [
            "contract",
            "creator",
            "name",
            "symbol"
          ],
          "properties": {
            "contract": {
              "description": "The instantiated collection contract address (primary key).",
