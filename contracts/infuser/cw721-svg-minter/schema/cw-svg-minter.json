{
  "contract_name": "cw-svg-minter",
  "contract_version": "0.0.2",
  "idl_version": "1.0.0",
  "instantiate": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "InstantiateMsg",
    "type": "object",
    "required": [
      "svg_code_id"
    ],
    "properties": {
      "dregg_ibc_only": {
        "description": "If true, only DREGG runtime accounts / IBC packets may mint (no public native mint).",
        "default": false,
        "type": "boolean"
      },
      "owner": {
        "description": "Optional owner. If set, only the owner may create collections.",
        "type": [
          "string",
          "null"
        ]
      },
      "runtime_minters": {
        "description": "Terp addrs the DREGG runtime uses (OR with IBC packet receive).",
        "default": [],
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "svg_code_id": {
        "description": "Code ID of the cw721-svg contract to instantiate.",
        "type": "integer",
        "format": "uint64",
        "minimum": 0.0
      }
    },
    "additionalProperties": false
  },
  "execute": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "ExecuteMsg",
    "oneOf": [
      {
        "description": "Create a new cw721-svg collection. Uses instantiate2 for deterministic, anti-collision address prediction.",
        "type": "object",
        "required": [
          "create_svg_collection"
        ],
        "properties": {
          "create_svg_collection": {
            "type": "object",
            "required": [
              "instantiate_msg",
              "label"
            ],
            "properties": {
              "instantiate_msg": {
                "$ref": "#/definitions/Cw721InstantiateMsg_for_SvgCollectionMetadata"
              },
              "label": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      {
        "description": "Owner-only: update the cw721-svg code ID used for new collections.",
        "type": "object",
        "required": [
          "update_code_id"
        ],
        "properties": {
          "update_code_id": {
            "type": "object",
            "required": [
              "code_id"
            ],
            "properties": {
              "code_id": {
                "type": "integer",
                "format": "uint64",
                "minimum": 0.0
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      {
        "description": "DREGG runtime submits a commitment packet (same bytes as IBC recv).",
        "type": "object",
        "required": [
          "recv_dregg_packet"
        ],
        "properties": {
          "recv_dregg_packet": {
            "type": "object",
            "required": [
              "packet"
            ],
            "properties": {
              "packet": {
                "$ref": "#/definitions/MintPacket"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      {
        "description": "Bind IBC channel/port after handshake (also used by migrate).",
        "type": "object",
        "required": [
          "bind_dregg_channel"
        ],
        "properties": {
          "bind_dregg_channel": {
            "type": "object",
            "required": [
              "channel",
              "port"
            ],
            "properties": {
              "channel": {
                "type": "string"
              },
              "port": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      {
        "description": "Update the contract's ownership. The `action` to be provided can be either to propose transferring ownership to an account, accept a pending ownership transfer, or renounce the ownership permanently.",
        "type": "object",
        "required": [
          "update_ownership"
        ],
        "properties": {
          "update_ownership": {
            "$ref": "#/definitions/Action"
          }
        },
        "additionalProperties": false
      }
    ],
    "definitions": {
      "Action": {
        "description": "Actions that can be taken to alter the contract's ownership",
        "oneOf": [
          {
            "description": "Propose to transfer the contract's ownership to another account, optionally with an expiry time.\n\nCan only be called by the contract's current owner.\n\nAny existing pending ownership transfer is overwritten.",
            "type": "object",
            "required": [
              "transfer_ownership"
            ],
            "properties": {
              "transfer_ownership": {
                "type": "object",
                "required": [
                  "new_owner"
                ],
                "properties": {
                  "expiry": {
                    "anyOf": [
                      {
                        "$ref": "#/definitions/Expiration"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "new_owner": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          {
            "description": "Accept the pending ownership transfer.\n\nCan only be called by the pending owner.",
            "type": "string",
            "enum": [
              "accept_ownership"
            ]
          },
          {
            "description": "Give up the contract's ownership and the possibility of appointing a new owner.\n\nCan only be invoked by the contract's current owner.\n\nAny existing pending ownership transfer is canceled.",
            "type": "string",
            "enum": [
              "renounce_ownership"
            ]
          }
        ]
      },
      "Binary": {
        "description": "Binary is a wrapper around Vec<u8> to add base64 de/serialization with serde. It also adds some helper methods to help encode inline.\n\nThis is only needed as serde-json-{core,wasm} has a horrible encoding for Vec<u8>. See also <https://github.com/CosmWasm/cosmwasm/blob/main/docs/MESSAGE_TYPES.md>.",
        "type": "string"
      },
      "Coin": {
        "type": "object",
        "required": [
          "amount",
          "denom"
        ],
        "properties": {
          "amount": {
            "$ref": "#/definitions/Uint256"
          },
          "denom": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "Cw721InstantiateMsg_for_SvgCollectionMetadata": {
        "type": "object",
        "required": [
          "collection_info_extension",
          "name",
          "symbol"
        ],
        "properties": {
          "collection_info_extension": {
            "description": "Optional extension of the collection metadata",
            "allOf": [
              {
                "$ref": "#/definitions/SvgCollectionMetadata"
              }
            ]
          },
          "creator": {
            "description": "Sets the creator of collection. The creator is the only one eligible to update `CollectionInfo`.",
            "type": [
              "string",
              "null"
            ]
          },
          "minter": {
            "description": "The minter is the only one who can create new NFTs. This is designed for a base NFT that is controlled by an external program or contract. You will likely replace this with custom logic in custom NFTs",
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "description": "Name of the NFT contract",
            "type": "string"
          },
          "symbol": {
            "description": "Symbol of the NFT contract",
            "type": "string"
          },
          "withdraw_address": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      },
      "Expiration": {
        "description": "Expiration represents a point in time when some event happens. It can compare with a BlockInfo and will return is_expired() == true once the condition is hit (and for every block in the future)",
        "oneOf": [
          {
            "description": "AtHeight will expire when `env.block.height` >= height",
            "type": "object",
            "required": [
              "at_height"
            ],
            "properties": {
              "at_height": {
                "type": "integer",
                "format": "uint64",
                "minimum": 0.0
              }
            },
            "additionalProperties": false
          },
          {
            "description": "AtTime will expire when `env.block.time` >= time",
            "type": "object",
            "required": [
              "at_time"
            ],
            "properties": {
              "at_time": {
                "$ref": "#/definitions/Timestamp"
              }
            },
            "additionalProperties": false
          },
          {
            "description": "Never will never expire. Used to express the empty variant",
            "type": "object",
            "required": [
              "never"
            ],
            "properties": {
              "never": {
                "type": "object",
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        ]
      },
      "MintPacket": {
        "type": "object",
        "required": [
          "bind",
          "c_action",
          "c_deposit",
          "n_deposit",
          "receipt"
        ],
        "properties": {
          "bind": {
            "$ref": "#/definitions/Binary"
          },
          "c_action": {
            "$ref": "#/definitions/Binary"
          },
          "c_deposit": {
            "$ref": "#/definitions/Binary"
          },
          "collection": {
            "default": "",
            "type": "string"
          },
          "n_deposit": {
            "$ref": "#/definitions/Binary"
          },
          "receipt": {
            "$ref": "#/definitions/Binary"
          },
          "token_recipient": {
            "default": "",
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "PriceTier": {
        "description": "A price tier that applies until the mint count reaches `until_count`. Tiers must be sorted ascending by `until_count`. Example: [{ until_count: 100, price: 1_000_000utoken }, { until_count: 500, price: 5_000_000utoken }] means: first 100 mints cost 1 token, mints 101-500 cost 5 tokens.",
        "type": "object",
        "required": [
          "price",
          "until_count"
        ],
        "properties": {
          "price": {
            "description": "Price per token in this tier",
            "allOf": [
              {
                "$ref": "#/definitions/Coin"
              }
            ]
          },
          "until_count": {
            "description": "This tier applies while mint_count < until_count",
            "type": "integer",
            "format": "uint64",
            "minimum": 0.0
          }
        },
        "additionalProperties": false
      },
      "RgbRange": {
        "type": "object",
        "required": [
          "b_max",
          "b_min",
          "g_max",
          "g_min",
          "r_max",
          "r_min"
        ],
        "properties": {
          "b_max": {
            "type": "integer",
            "format": "uint8",
            "minimum": 0.0
          },
          "b_min": {
            "type": "integer",
            "format": "uint8",
            "minimum": 0.0
          },
          "g_max": {
            "type": "integer",
            "format": "uint8",
            "minimum": 0.0
          },
          "g_min": {
            "type": "integer",
            "format": "uint8",
            "minimum": 0.0
          },
          "r_max": {
            "type": "integer",
            "format": "uint8",
            "minimum": 0.0
          },
          "r_min": {
            "type": "integer",
            "format": "uint8",
            "minimum": 0.0
          }
        },
        "additionalProperties": false
      },
      "SvgCollectionMetadata": {
        "type": "object",
        "required": [
          "price_tiers",
          "seed",
          "svg_template",
          "template_slots",
          "total",
          "variables"
        ],
        "properties": {
          "mint_end_time": {
            "anyOf": [
              {
                "$ref": "#/definitions/Timestamp"
              },
              {
                "type": "null"
              }
            ]
          },
          "mint_start_time": {
            "description": "Timestamp of mint start. If less than current block, mints available",
            "anyOf": [
              {
                "$ref": "#/definitions/Timestamp"
              },
              {
                "type": "null"
              }
            ]
          },
          "price_tiers": {
            "description": "Price tiers for minting. Empty or None = free mint.",
            "type": "array",
            "items": {
              "$ref": "#/definitions/PriceTier"
            }
          },
          "require_auth": {
            "description": "When true, every mint must include valid ADR-36 `ext` auth (`CosmosArbitrary` over DST+nonce[|digest]). Required for trustless pledge collections; default false preserves open-mint SVG drops.",
            "default": false,
            "type": "boolean"
          },
          "seed": {
            "$ref": "#/definitions/Binary"
          },
          "svg_template": {
            "type": "string"
          },
          "template_slots": {
            "description": "Pre-computed placeholder positions in the SVG template. Each slot maps a `${varname}` occurrence to its byte offsets and variable index.",
            "type": "array",
            "items": {
              "$ref": "#/definitions/TemplateSlot"
            }
          },
          "total": {
            "type": "integer",
            "format": "uint64",
            "minimum": 0.0
          },
          "variables": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/VariableDef"
            }
          },
          "whitelist": {
            "description": "Optional merkle whitelist contract address. Whitelisted minters bypass fees.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      },
      "TemplateSlot": {
        "type": "object",
        "required": [
          "end",
          "start",
          "var_idx"
        ],
        "properties": {
          "end": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0.0
          },
          "start": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0.0
          },
          "var_idx": {
            "type": "integer",
            "format": "uint16",
            "minimum": 0.0
          }
        },
        "additionalProperties": false
      },
      "Timestamp": {
        "description": "A point in time in nanosecond precision.\n\nThis type can represent times from 1970-01-01T00:00:00Z to 2554-07-21T23:34:33Z.\n\n## Examples\n\n``` # use cosmwasm_std::Timestamp; let ts = Timestamp::from_nanos(1_000_000_202); assert_eq!(ts.nanos(), 1_000_000_202); assert_eq!(ts.seconds(), 1); assert_eq!(ts.subsec_nanos(), 202);\n\nlet ts = ts.plus_seconds(2); assert_eq!(ts.nanos(), 3_000_000_202); assert_eq!(ts.seconds(), 3); assert_eq!(ts.subsec_nanos(), 202); ```",
        "allOf": [
          {
            "$ref": "#/definitions/Uint64"
          }
        ]
      },
      "Uint256": {
        "description": "An implementation of u256 that is using strings for JSON encoding/decoding, such that the full u256 range can be used for clients that convert JSON numbers to floats, like JavaScript and jq.\n\n# Examples\n\nUse `new` to create instances out of u128, `from` for other primitive uint types or `from_be_bytes` to provide big endian bytes:\n\n``` # use cosmwasm_std::Uint256; let a = Uint256::new(258u128); let b = Uint256::from(258u16); let c = Uint256::from_be_bytes([ 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 1u8, 2u8, ]); assert_eq!(a, b); assert_eq!(a, c); ```",
        "type": "string"
      },
      "Uint64": {
        "description": "A thin wrapper around u64 that is using strings for JSON encoding/decoding, such that the full u64 range can be used for clients that convert JSON numbers to floats, like JavaScript and jq.\n\n# Examples\n\nUse `from` to create instances of this and `u64` to get the value out:\n\n``` # use cosmwasm_std::Uint64; let a = Uint64::from(42u64); assert_eq!(a.u64(), 42);\n\nlet b = Uint64::from(70u32); assert_eq!(b.u64(), 70); ```",
        "type": "string"
      },
      "VariableDef": {
        "type": "object",
        "required": [
          "kind",
          "name"
        ],
        "properties": {
          "kind": {
            "$ref": "#/definitions/VariableKind"
          },
          "name": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "VariableKind": {
        "oneOf": [
          {
            "description": "Pick from a list of string values",
            "type": "object",
            "required": [
              "options"
            ],
            "properties": {
              "options": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          },
          {
            "description": "Generate a decimal string in [min, max] at given precision. `min` and `max` are decimal strings (e.g. \"-2.5\", \"80\").",
            "type": "object",
            "required": [
              "range"
            ],
            "properties": {
              "range": {
                "type": "object",
                "required": [
                  "max",
                  "min",
                  "precision"
                ],
                "properties": {
                  "max": {
                    "type": "string"
                  },
                  "min": {
                    "type": "string"
                  },
                  "precision": {
                    "type": "integer",
                    "format": "uint32",
                    "minimum": 0.0
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          {
            "description": "Generate a random `rgb(R,G,B)` color string. Each channel is independently random in 0–255.",
            "type": "string",
            "enum": [
              "rgb"
            ]
          },
          {
            "description": "Pick a random range from the list, then generate a random shade within it. Each channel is constrained to [min, max] of the selected range.",
            "type": "object",
            "required": [
              "rgb_styled"
            ],
            "properties": {
              "rgb_styled": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/RgbRange"
                }
              }
            },
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "query": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "QueryMsg",
    "oneOf": [
      {
        "description": "Returns a paginated list of all svg collections.",
        "type": "object",
