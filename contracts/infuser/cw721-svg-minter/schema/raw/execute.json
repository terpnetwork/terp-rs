{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ExecuteMsg",
  "oneOf": [
    {
      "description": "Create a new cw721-svg collection. Uses instantiate2 for deterministic, anti-collision address prediction.",
      "type": "object",
      "required": [
        "create_svg_collection"
      ],
      "properties": {
        "create_svg_collection": {
          "type": "object",
          "required": [
            "instantiate_msg",
            "label"
          ],
          "properties": {
            "instantiate_msg": {
              "$ref": "#/definitions/Cw721InstantiateMsg_for_SvgCollectionMetadata"
            },
            "label": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Create a collection under a rate-limited series (see SeriesConfig). The series must exist; the cadence is enforced here for every sender, including the owner.",
      "type": "object",
      "required": [
        "create_series_collection"
      ],
      "properties": {
        "create_series_collection": {
          "type": "object",
          "required": [
            "instantiate_msg",
            "label",
            "series"
          ],
          "properties": {
            "instantiate_msg": {
              "$ref": "#/definitions/Cw721InstantiateMsg_for_SvgCollectionMetadata"
            },
            "label": {
              "type": "string"
            },
            "series": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Owner-only: set (Some) or remove (None) a series config.",
      "type": "object",
      "required": [
        "set_series"
      ],
      "properties": {
        "set_series": {
          "type": "object",
          "required": [
            "series"
          ],
          "properties": {
            "config": {
              "anyOf": [
                {
                  "$ref": "#/definitions/SeriesConfig"
                },
                {
                  "type": "null"
                }
              ]
            },
            "series": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Owner-only: update the cw721-svg code ID used for new collections.",
      "type": "object",
      "required": [
        "update_code_id"
      ],
      "properties": {
        "update_code_id": {
          "type": "object",
          "required": [
            "code_id"
          ],
          "properties": {
            "code_id": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0.0
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "DREGG runtime submits a commitment packet (same bytes as IBC recv).",
      "type": "object",
      "required": [
        "recv_dregg_packet"
      ],
      "properties": {
        "recv_dregg_packet": {
          "type": "object",
          "required": [
            "packet"
          ],
          "properties": {
            "packet": {
              "$ref": "#/definitions/MintPacket"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Bind IBC channel/port after handshake (also used by migrate).",
      "type": "object",
      "required": [
        "bind_dregg_channel"
      ],
      "properties": {
        "bind_dregg_channel": {
          "type": "object",
          "required": [
            "channel",
            "port"
          ],
          "properties": {
            "channel": {
              "type": "string"
            },
            "port": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Owner-only: set (Some) or clear (None) the default oracle pricing for new collections. Existing collections are unchanged.",
      "type": "object",
      "required": [
        "update_oracle_pricing"
      ],
      "properties": {
        "update_oracle_pricing": {
          "type": "object",
          "properties": {
            "pricing": {
              "anyOf": [
                {
                  "$ref": "#/definitions/OraclePricing"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Update the contract's ownership. The `action` to be provided can be either to propose transferring ownership to an account, accept a pending ownership transfer, or renounce the ownership permanently.",
      "type": "object",
      "required": [
        "update_ownership"
      ],
      "properties": {
        "update_ownership": {
          "$ref": "#/definitions/Action"
        }
      },
      "additionalProperties": false
    }
  ],
  "definitions": {
    "Action": {
      "description": "Actions that can be taken to alter the contract's ownership",
      "oneOf": [
        {
          "description": "Propose to transfer the contract's ownership to another account, optionally with an expiry time.\n\nCan only be called by the contract's current owner.\n\nAny existing pending ownership transfer is overwritten.",
          "type": "object",
          "required": [
            "transfer_ownership"
          ],
          "properties": {
            "transfer_ownership": {
              "type": "object",
              "required": [
                "new_owner"
              ],
              "properties": {
                "expiry": {
                  "anyOf": [
                    {
                      "$ref": "#/definitions/Expiration"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "new_owner": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        {
          "description": "Accept the pending ownership transfer.\n\nCan only be called by the pending owner.",
          "type": "string",
          "enum": [
            "accept_ownership"
          ]
        },
        {
          "description": "Give up the contract's ownership and the possibility of appointing a new owner.\n\nCan only be invoked by the contract's current owner.\n\nAny existing pending ownership transfer is canceled.",
          "type": "string",
          "enum": [
            "renounce_ownership"
          ]
        }
      ]
    },
    "AggregateMethod": {
      "description": "How several values are combined into one.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "median",
            "min",
            "max"
          ]
        },
        {
          "description": "Weighted by `Feed::weight` (default 1) when combining feeds, and by nothing when combining a history window.",
          "type": "string",
          "enum": [
            "mean"
          ]
        },
        {
          "description": "Weighted by observation count (`PricePoint::observations`) when combining feeds, and by block gap (piecewise constant, like the registry TWAP) on a history window.",
          "type": "string",
          "enum": [
            "weighted"
          ]
        }
      ]
    },
    "AltAsset": {
      "description": "An alternate asset accepted in place of `base_denom`.",
      "type": "object",
      "required": [
        "alt_decimals",
        "asset",
        "base_decimals",
        "base_denom",
        "feeds",
        "quote"
      ],
      "properties": {
        "alt_decimals": {
          "description": "Decimals of the alt asset.",
          "type": "integer",
          "format": "uint8",
          "minimum": 0.0
        },
        "asset": {
          "$ref": "#/definitions/PriceAsset"
        },
        "base_decimals": {
          "description": "Decimals of the base denom (e.g. 6 for uterp).",
          "type": "integer",
          "format": "uint8",
          "minimum": 0.0
        },
        "base_denom": {
          "description": "The default mint asset this alt is priced against.",
          "type": "string"
        },
        "combine": {
          "description": "How feed values are combined. Default median.",
          "default": "median",
          "allOf": [
            {
              "$ref": "#/definitions/AggregateMethod"
            }
          ]
        },
        "feeds": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Feed"
          }
        },
        "quote": {
          "$ref": "#/definitions/Quote"
        }
      },
      "additionalProperties": false
    },
    "Binary": {
      "description": "Binary is a wrapper around Vec<u8> to add base64 de/serialization with serde. It also adds some helper methods to help encode inline.\n\nThis is only needed as serde-json-{core,wasm} has a horrible encoding for Vec<u8>. See also <https://github.com/CosmWasm/cosmwasm/blob/main/docs/MESSAGE_TYPES.md>.",
      "type": "string"
    },
    "Coin": {
      "type": "object",
      "required": [
        "amount",
        "denom"
      ],
      "properties": {
        "amount": {
          "$ref": "#/definitions/Uint256"
        },
        "denom": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "Cw721InstantiateMsg_for_SvgCollectionMetadata": {
      "type": "object",
      "required": [
        "collection_info_extension",
        "name",
        "symbol"
      ],
      "properties": {
        "collection_info_extension": {
          "description": "Optional extension of the collection metadata",
          "allOf": [
            {
              "$ref": "#/definitions/SvgCollectionMetadata"
            }
          ]
        },
        "creator": {
          "description": "Sets the creator of collection. The creator is the only one eligible to update `CollectionInfo`.",
          "type": [
            "string",
            "null"
          ]
        },
        "minter": {
          "description": "The minter is the only one who can create new NFTs. This is designed for a base NFT that is controlled by an external program or contract. You will likely replace this with custom logic in custom NFTs",
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "description": "Name of the NFT contract",
          "type": "string"
        },
        "symbol": {
          "description": "Symbol of the NFT contract",
          "type": "string"
        },
        "withdraw_address": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "Decimal": {
      "description": "A fixed-point decimal value with 18 fractional digits, i.e. Decimal(1_000_000_000_000_000_000) == 1.0\n\nThe greatest possible value that can be represented is 340282366920938463463.374607431768211455 = (2^128 - 1) / 10^18",
      "type": "string"
    },
    "Expiration": {
      "description": "Expiration represents a point in time when some event happens. It can compare with a BlockInfo and will return is_expired() == true once the condition is hit (and for every block in the future)",
      "oneOf": [
        {
          "description": "AtHeight will expire when `env.block.height` >= height",
          "type": "object",
          "required": [
            "at_height"
          ],
          "properties": {
            "at_height": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0.0
            }
          },
          "additionalProperties": false
        },
        {
          "description": "AtTime will expire when `env.block.time` >= time",
          "type": "object",
          "required": [
            "at_time"
          ],
          "properties": {
            "at_time": {
              "$ref": "#/definitions/Timestamp"
            }
          },
          "additionalProperties": false
        },
        {
          "description": "Never will never expire. Used to express the empty variant",
          "type": "object",
          "required": [
            "never"
          ],
          "properties": {
            "never": {
              "type": "object",
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "Feed": {
      "description": "One oracle source.",
      "type": "object",
      "required": [
        "kind",
        "oracle"
      ],
      "properties": {
        "kind": {
          "$ref": "#/definitions/FeedKind"
        },
        "oracle": {
          "description": "Oracle contract address (registry, aggregator or probe, matching `kind`).",
          "type": "string"
        },
        "weight": {
          "description": "Weight for `AggregateMethod::Mean` across feeds. Default 1.",
          "default": null,
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    },
    "FeedKind": {
      "description": "What to read from one oracle contract.",
      "oneOf": [
        {
          "description": "Registry `Latest { market_id }`.",
          "type": "object",
          "required": [
            "spot"
          ],
          "properties": {
            "spot": {
              "type": "object",
              "required": [
                "market_id"
              ],
              "properties": {
                "market_id": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        {
          "description": "Registry `Twap` over the newest `window_blocks` heights ending at the latest observation.",
          "type": "object",
          "required": [
            "twap"
          ],
          "properties": {
            "twap": {
              "type": "object",
              "required": [
                "market_id",
                "window_blocks"
              ],
              "properties": {
                "market_id": {
                  "type": "string"
                },
                "window_blocks": {
                  "type": "integer",
                  "format": "uint64",
                  "minimum": 0.0
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        {
          "description": "Registry `History { limit }`, combined locally with `method`.",
          "type": "object",
          "required": [
            "history"
          ],
          "properties": {
            "history": {
              "type": "object",
              "required": [
                "limit",
                "market_id",
                "method"
              ],
              "properties": {
                "limit": {
                  "type": "integer",
                  "format": "uint32",
                  "minimum": 0.0
                },
                "market_id": {
                  "type": "string"
                },
                "method": {
                  "$ref": "#/definitions/AggregateMethod"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        {
          "description": "Aggregator `Median { market_id, window }`. The height comes from the aggregator's registry `Latest`, so staleness checks still apply.",
          "type": "object",
          "required": [
            "aggregator_median"
          ],
          "properties": {
            "aggregator_median": {
              "type": "object",
              "required": [
                "market_id",
                "window"
              ],
              "properties": {
                "market_id": {
                  "type": "string"
                },
                "window": {
                  "type": "integer",
                  "format": "uint32",
                  "minimum": 0.0
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        {
          "description": "TWAP probe `ArithmeticTwap { pool_id }`. Carries no height.",
          "type": "object",
          "required": [
            "probe_twap"
          ],
          "properties": {
            "probe_twap": {
              "type": "object",
              "required": [
                "pool_id"
              ],
              "properties": {
                "pool_id": {
                  "type": "integer",
                  "format": "uint64",
                  "minimum": 0.0
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "MintPacket": {
      "type": "object",
      "required": [
        "bind",
        "c_action",
        "c_deposit",
        "n_deposit",
        "receipt"
      ],
      "properties": {
        "bind": {
          "$ref": "#/definitions/Binary"
        },
        "c_action": {
          "$ref": "#/definitions/Binary"
        },
        "c_deposit": {
          "$ref": "#/definitions/Binary"
        },
        "collection": {
          "default": "",
          "type": "string"
        },
        "n_deposit": {
          "$ref": "#/definitions/Binary"
        },
        "receipt": {
          "$ref": "#/definitions/Binary"
        },
        "token_recipient": {
          "default": "",
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "OraclePricing": {
      "description": "Optional oracle pricing for a minting contract.\n\nAbsent, or `enforce == false`: only the default asset is accepted and payment behaves as before. The oracle queries still answer, so a frontend can show prices before enforcement is switched on.",
      "type": "object",
      "required": [
        "alt_assets",
        "enforce"
      ],
      "properties": {
        "alt_assets": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/AltAsset"
          }
        },
        "enforce": {
          "type": "boolean"
        },
        "policy": {
          "default": {
            "max_deviation": null,
            "max_staleness_blocks": null,
            "min_observations": null,
            "min_sources": null,
            "slippage": null
          },
          "allOf": [
            {
              "$ref": "#/definitions/PricingPolicy"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "PriceAsset": {
      "description": "An asset priced by the oracle: a native/IBC/factory denom or a cw20 address.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "native"
          ],
          "properties": {
            "native": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "cw20"
          ],
          "properties": {
            "cw20": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "PriceTier": {
      "description": "A price tier that applies until the mint count reaches `until_count`. Tiers must be sorted ascending by `until_count`. Example: [{ until_count: 100, price: 1_000_000utoken }, { until_count: 500, price: 5_000_000utoken }] means: first 100 mints cost 1 token, mints 101-500 cost 5 tokens.",
      "type": "object",
      "required": [
        "price",
        "until_count"
      ],
      "properties": {
        "price": {
          "description": "Price per token in this tier",
          "allOf": [
            {
              "$ref": "#/definitions/Coin"
            }
          ]
        },
        "until_count": {
          "description": "This tier applies while mint_count < until_count",
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    },
    "PricingPolicy": {
      "description": "Guards applied to every price read.",
      "type": "object",
      "properties": {
        "max_deviation": {
          "description": "Max relative spread between any feed and the combined price, e.g. 0.05.",
          "default": null,
          "anyOf": [
            {
              "$ref": "#/definitions/Decimal"
            },
            {
              "type": "null"
            }
          ]
        },
        "max_staleness_blocks": {
          "description": "Max `env.block.height - observation.height`. Requires feeds that record local (terp) heights. `None` disables the check.",
          "default": null,
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "min_observations": {
          "description": "Min total observations behind the combined price. Default none.",
          "default": null,
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0.0
        },
        "min_sources": {
          "description": "Min number of feeds that must answer. Default 1.",
          "default": null,
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0.0
        },
        "slippage": {
          "description": "Accepted underpayment against the quote, e.g. 0.01 = pay at least 99%. Overpayment is refunded.",
          "default": null,
          "anyOf": [
            {
              "$ref": "#/definitions/Decimal"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "Quote": {
      "description": "Direction of the feed price.",
      "oneOf": [
        {
          "description": "Feed value = base units per 1 alt (in display units). E.g. feed `ATOM/TERP = 12.5`, base TERP, alt ATOM: 1 ATOM costs 12.5 TERP.",
          "type": "string",
          "enum": [
            "alt_in_base"
          ]
        },
        {
          "description": "Feed value = alt units per 1 base (in display units).",
          "type": "string",
          "enum": [
            "base_in_alt"
          ]
        }
      ]
    },
    "SeriesConfig": {
      "description": "Contract-enforced creation cadence for a named series (e.g. \"latent-benders\", \"marain-orbs\"). Every field is optional; an unset field is not enforced.",
      "type": "object",
      "properties": {
        "max_mint_window_secs": {
          "description": "If set, each collection must set mint_end_time (seconds after creation) and it must be at most this value.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "max_per_window": {
          "description": "At most this many collections per rolling `window_secs`.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0.0
        },
        "min_interval_secs": {
          "description": "Minimum seconds between two collections of this series.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "operators": {
          "description": "Who may create in this series besides the factory owner. Empty = anyone.",
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "window_secs": {
          "description": "Rolling window for `max_per_window`; default 86400 (one day).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    },
    "SvgCollectionMetadata": {
      "type": "object",
      "required": [
        "packed",
        "price_tiers",
        "seed",
        "total"
      ],
      "properties": {
        "mint_end_time": {
          "anyOf": [
            {
              "$ref": "#/definitions/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "mint_start_time": {
          "description": "Timestamp of mint start. If less than current block, mints available",
          "anyOf": [
            {
              "$ref": "#/definitions/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "packed": {
          "description": "SVP1-packed template + variables (`cw-svg-pack`). Required on create. Stored once under its own key; empty in stored config / collection info.",
          "allOf": [
            {
              "$ref": "#/definitions/Binary"
            }
          ]
        },
        "price_tiers": {
          "description": "Price tiers for minting. Empty or None = free mint.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/PriceTier"
          }
        },
        "require_auth": {
          "description": "When true, every mint must include valid ADR-36 `ext` auth (`CosmosArbitrary` over DST+nonce[|digest]). Required for trustless pledge collections; default false preserves open-mint SVG drops.",
          "default": false,
          "type": "boolean"
        },
        "seed": {
          "$ref": "#/definitions/Binary"
        },
        "total": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "whitelist": {
          "description": "Optional merkle whitelist contract address. Whitelisted minters bypass fees.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "Timestamp": {
