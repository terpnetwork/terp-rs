              ]
            },
            "instant_sale": {
              "description": "First bid must equal the reserve and the auction settles in that transaction.",
              "default": false,
              "type": "boolean"
            },
            "reserve_price": {
              "$ref": "#/definitions/Coin"
            },
            "seller": {
              "$ref": "#/definitions/Addr"
            },
            "seller_funds_recipient": {
              "anyOf": [
