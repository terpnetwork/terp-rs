{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HaltManager",
  "type": "object",
  "required": [
    "halt_windows",
    "prev_block_time"
  ],
  "properties": {
    "halt_windows": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/HaltWindow"
      }
    },
    "prev_block_time": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    }
  },
  "additionalProperties": false,
  "definitions": {
    "HaltWindow": {
      "type": "object",
      "required": [
        "end_time",
        "start_time"
      ],
      "properties": {
        "end_time": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "start_time": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    }
  }
}
