  "definitions": {
    "Binary": {
      "description": "Binary is a wrapper around Vec<u8> to add base64 de/serialization with serde. It also adds some helper methods to help encode inline.\n\nThis is only needed as serde-json-{core,wasm} has a horrible encoding for Vec<u8>. See also <https://github.com/CosmWasm/cosmwasm/blob/main/docs/MESSAGE_TYPES.md>.",
      "type": "string"
    },
    "Coin": {
      "type": "object",
      "required": [
        "amount",
        "denom"
      ],
      "properties": {
        "amount": {
          "$ref": "#/definitions/Uint256"
        },
        "denom": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "Cw721ReceiveMsg": {
      "type": "object",
      "required": [
        "msg",
        "sender",
        "token_id"
      ],
      "properties": {
        "msg": {
          "$ref": "#/definitions/Binary"
        },
        "sender": {
          "type": "string"
        },
        "token_id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "InstantiateMsg": {
      "type": "object",
      "required": [
        "burn_bps",
        "default_denom",
        "fee_manager",
        "maker_reward_bps",
        "max_royalty_fee_bps",
        "protocol_fee_bps",
        "taker_reward_bps"
      ],
      "properties": {
        "burn_bps": {
          "description": "Share of the remaining protocol fee (and of listing fees) that is burned. The rest goes to `fee_manager`.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "default_denom": {
          "type": "string"
        },
        "fee_manager": {
          "type": "string"
        },
        "maker_reward_bps": {
          "description": "Finder reward as a fraction of the protocol fee, in basis points.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "max_royalty_fee_bps": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "protocol_fee_bps": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "royalty_registry": {
          "description": "Optional Stargaze-style royalty registry. cw721 collection royalties are used when this is unset or returns nothing.",
          "type": [
            "string",
            "null"
          ]
        },
        "taker_reward_bps": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    },
    "OrderDetails": {
      "description": "Message-level order terms. Addresses are validated before storage.",
      "type": "object",
      "required": [
        "price"
      ],
      "properties": {
        "finder": {
          "type": [
            "string",
            "null"
          ]
        },
        "price": {
