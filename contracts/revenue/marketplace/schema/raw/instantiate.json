{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "InstantiateMsg",
  "type": "object",
  "required": [
    "burn_bps",
    "default_denom",
    "fee_manager",
    "maker_reward_bps",
    "max_royalty_fee_bps",
    "protocol_fee_bps",
    "taker_reward_bps"
  ],
  "properties": {
    "burn_bps": {
      "description": "Share of the remaining protocol fee (and of listing fees) that is burned. The rest goes to `fee_manager`.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    },
    "default_denom": {
      "type": "string"
    },
    "fee_manager": {
      "type": "string"
    },
    "maker_reward_bps": {
      "description": "Finder reward as a fraction of the protocol fee, in basis points.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    },
    "max_royalty_fee_bps": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    },
    "protocol_fee_bps": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    },
    "royalty_registry": {
      "description": "Optional Stargaze-style royalty registry. cw721 collection royalties are used when this is unset or returns nothing.",
      "type": [
        "string",
        "null"
      ]
    },
    "taker_reward_bps": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    }
  },
  "additionalProperties": false
}
