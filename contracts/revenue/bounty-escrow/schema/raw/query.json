{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "QueryMsg",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "config"
      ],
      "properties": {
        "config": {
          "type": "object",
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "bounty"
      ],
      "properties": {
        "bounty": {
          "type": "object",
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0.0
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "bounty_by_ref"
      ],
      "properties": {
        "bounty_by_ref": {
          "type": "object",
          "required": [
            "bounty_ref"
          ],
          "properties": {
            "bounty_ref": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "bounties"
      ],
      "properties": {
        "bounties": {
          "type": "object",
          "properties": {
            "limit": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint32",
              "minimum": 0.0
            },
            "proposer": {
              "type": [
                "string",
                "null"
              ]
            },
            "start_after": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint64",
              "minimum": 0.0
            },
            "status": {
              "anyOf": [
                {
                  "$ref": "#/definitions/BountyStatus"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "submissions"
      ],
      "properties": {
        "submissions": {
          "type": "object",
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0.0
            },
            "limit": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint32",
              "minimum": 0.0
            },
            "start_after": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint32",
              "minimum": 0.0
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "is_eligible"
      ],
      "properties": {
        "is_eligible": {
          "type": "object",
          "required": [
            "address"
          ],
          "properties": {
            "address": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Whether `address` passes the submission stake gate (min_submit_stake).",
      "type": "object",
      "required": [
        "can_submit"
      ],
      "properties": {
        "can_submit": {
          "type": "object",
          "required": [
            "address"
          ],
          "properties": {
            "address": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Whether `address` passes the upload stake gate (min_upload_stake) of the CID storage service.",
      "type": "object",
      "required": [
        "can_upload"
      ],
      "properties": {
        "can_upload": {
          "type": "object",
          "required": [
            "address"
          ],
          "properties": {
            "address": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "allowlist"
      ],
      "properties": {
        "allowlist": {
          "type": "object",
          "properties": {
            "limit": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint32",
              "minimum": 0.0
            },
            "start_after": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "cw2 contract name and version.",
      "type": "object",
      "required": [
        "info"
      ],
      "properties": {
        "info": {
          "type": "object",
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "The DAO core this module belongs to.",
      "type": "object",
      "required": [
        "dao"
      ],
      "properties": {
        "dao": {
          "type": "object",
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "A bounty as a proposal.",
      "type": "object",
      "required": [
        "proposal"
      ],
      "properties": {
        "proposal": {
          "type": "object",
          "required": [
            "proposal_id"
          ],
          "properties": {
            "proposal_id": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0.0
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Bounties as proposals, ascending by id.",
      "type": "object",
      "required": [
        "list_proposals"
      ],
      "properties": {
        "list_proposals": {
          "type": "object",
          "properties": {
            "limit": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint64",
              "minimum": 0.0
            },
            "start_after": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint64",
              "minimum": 0.0
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Bounties as proposals, descending by id.",
      "type": "object",
      "required": [
        "reverse_proposals"
      ],
      "properties": {
        "reverse_proposals": {
          "type": "object",
          "properties": {
            "limit": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint64",
              "minimum": 0.0
            },
            "start_before": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint64",
              "minimum": 0.0
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Number of bounties ever created.",
      "type": "object",
      "required": [
        "proposal_count"
      ],
      "properties": {
        "proposal_count": {
          "type": "object",
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Id the next bounty will get.",
      "type": "object",
      "required": [
        "next_proposal_id"
      ],
      "properties": {
        "next_proposal_id": {
          "type": "object",
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Who may create bounties (Anyone or a pre-propose module).",
      "type": "object",
      "required": [
        "proposal_creation_policy"
      ],
      "properties": {
        "proposal_creation_policy": {
          "type": "object",
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Registered proposal hook receivers.",
      "type": "object",
      "required": [
        "proposal_hooks"
      ],
      "properties": {
        "proposal_hooks": {
          "type": "object",
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  ],
  "definitions": {
    "BountyStatus": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "assigned",
            "submitted",
            "paid",
            "cancelled",
            "refunded",
            "expired"
          ]
        },
        {
          "description": "Funded, waiting for the approver to list it.",
          "type": "string",
          "enum": [
            "pending"
          ]
        },
        {
          "description": "Listed (approved); accepting applications off-chain.",
          "type": "string",
          "enum": [
            "open"
          ]
        },
        {
          "description": "Work accepted by the approver; awaiting (or partially through) payout.",
          "type": "string",
          "enum": [
            "accepted"
          ]
        }
      ]
    }
  }
}
