      {
        "name": "cw_vote_ceremony_msg_RegistrationGate",
        "description": "How Register is gated for this session (configurable product policy).",
        "type": "enum",
        "cases": {
          "clerk_attested": {
            "description": "Register requires a clerk-attested leaf_commit (dregg / event-reg clerk).",
            "type": "unit"
          },
          "dao_member": {
            "description": "Register requires non-zero voting power on membership_module.",
            "type": "unit"
          },
          "open": {
            "description": "Anyone with gas while registration_open (legacy).",
            "type": "unit"
          },
          "pre_propose": {
            "description": "Hook site for pre-propose; not fully wired (rejects until implemented).",
            "type": "unit"
          },
          "vm_proof": {
            "description": "Dummy SA / wasmvm Authenticate stand-in (`vm_verifier` query VerifyMinHolders).",
            "type": "unit"
          }
        }
      },
      {
        "name": "cosmwasm_std_binary_Binary",
        "description": "Binary is a wrapper around Vec<u8> to add base64 de/serialization\nwith serde. It also adds some helper methods to help encode inline.\n\nThis is only needed as serde-json-{core,wasm} has a horrible encoding for Vec<u8>.\nSee also <https://github.com/CosmWasm/cosmwasm/blob/main/docs/MESSAGE_TYPES.md>.",
