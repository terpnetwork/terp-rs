{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Nullable_AssetEntry",
  "anyOf": [
    {
      "$ref": "#/definitions/AssetEntry"
    },
    {
      "type": "null"
    }
  ],
  "definitions": {
    "AssetEntry": {
      "type": "object",
      "required": [
        "asset_id",
        "local_denom",
        "status"
      ],
      "properties": {
        "asset_id": {
          "description": "Domain-separated Terp asset id (32 bytes).",
          "allOf": [
            {
              "$ref": "#/definitions/Binary"
            }
          ]
        },
        "local_denom": {
          "description": "Local denom or proof representation string.",
          "type": "string"
        },
        "origin": {
          "description": "Optional origin tag (e.g. `native`, `tacit:bitcoin-mainnet`, IBC trace).",
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "$ref": "#/definitions/AssetStatus"
        }
      },
      "additionalProperties": false
    },
    "AssetStatus": {
      "type": "string",
      "enum": [
        "active",
        "paused",
        "frozen"
      ]
    },
    "Binary": {
      "description": "Binary is a wrapper around Vec<u8> to add base64 de/serialization with serde. It also adds some helper methods to help encode inline.\n\nThis is only needed as serde-json-{core,wasm} has a horrible encoding for Vec<u8>. See also <https://github.com/CosmWasm/cosmwasm/blob/main/docs/MESSAGE_TYPES.md>.",
      "type": "string"
    }
  }
}
