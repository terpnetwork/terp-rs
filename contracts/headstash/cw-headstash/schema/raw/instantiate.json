{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "InstantiateMsg",
  "type": "object",
  "required": [
    "genesis_root",
    "token_strategy",
    "wavs"
  ],
  "properties": {
    "circuit_id": {
      "description": "Stored circuit id after zkvm `store-circuit` / `upload_circuit` (default 0 until set).",
      "default": null,
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0.0
    },
    "distro_hash_domain": {
      "description": "Public inclusion hash domain. Defaults to `poseidon-v1` for new Headstashes. Use `sinsemilla-legacy` only for recovery of pre-Poseidon trees.",
      "default": "poseidon_v1",
      "allOf": [
        {
          "$ref": "#/definitions/DistroHashDomain"
        }
      ]
    },
    "genesis_label": {
      "description": "Optional label for the genesis eligibility set.",
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "genesis_root": {
      "description": "Headstash genesis merkle tree root (32 bytes). Registered as `root_id = 0`. Product A: depth-32 Poseidon-v1 path root (not shallow suite root).",
      "allOf": [
        {
          "$ref": "#/definitions/Binary"
        }
      ]
    },
    "token_strategy": {
      "description": "Token strategies for the tokens distributed to headstash users",
      "allOf": [
        {
          "$ref": "#/definitions/TokenStrategy"
        }
      ]
    },
    "wavs": {
      "description": "Aggregated list of keys",
      "allOf": [
        {
          "$ref": "#/definitions/WavsProofOfOwnership"
        }
      ]
    }
  },
  "additionalProperties": false,
  "definitions": {
    "Binary": {
      "description": "Binary is a wrapper around Vec<u8> to add base64 de/serialization with serde. It also adds some helper methods to help encode inline.\n\nThis is only needed as serde-json-{core,wasm} has a horrible encoding for Vec<u8>. See also <https://github.com/CosmWasm/cosmwasm/blob/main/docs/MESSAGE_TYPES.md>.",
      "type": "string"
    },
    "DenomUnit": {
      "type": "object",
      "required": [
        "aliases",
        "denom",
        "exponent"
      ],
      "properties": {
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "denom": {
          "type": "string"
        },
        "exponent": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    },
    "DistroHashDomain": {
      "description": "Wire / JSON unit names are `poseidon_v1` / `sinsemilla_legacy` (cw_serde identifiers). Human/ADR tags from [`DistroHashDomain::as_str`] are `poseidon-v1` / `sinsemilla-legacy`.\n\nNew Headstashes default to [`DistroHashDomain::PoseidonV1`]. [`DistroHashDomain::SinsemillaLegacy`] is recovery-only for pre-Poseidon trees.",
      "oneOf": [
        {
          "description": "Poseidon over `pallas::Base` — ADR default for public inclusion.",
          "type": "string",
          "enum": [
            "poseidon_v1"
          ]
        },
        {
          "description": "Orchard-family Sinsemilla — legacy recovery only; not for new drops.",
          "type": "string",
          "enum": [
            "sinsemilla_legacy"
          ]
        }
      ]
    },
    "HeadstashTokenObject": {
      "type": "object",
      "required": [
        "proof",
        "raw"
      ],
      "properties": {
        "proof": {
          "$ref": "#/definitions/Binary"
        },
        "raw": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "InitialMint": {
      "type": "object",
      "required": [
        "amount",
        "to_address"
      ],
      "properties": {
        "amount": {
          "$ref": "#/definitions/Uint128"
        },
        "to_address": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "Metadata": {
      "type": "object",
      "required": [
        "denom_units"
      ],
      "properties": {
        "base": {
          "type": [
            "string",
            "null"
          ]
        },
        "denom_units": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DenomUnit"
          }
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "display": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "symbol": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "NewTokenConfig": {
      "type": "object",
      "required": [
        "metadata",
        "minters",
        "subdenom"
      ],
      "properties": {
        "initial_mint": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/definitions/InitialMint"
          }
        },
        "manager": {
          "type": [
            "string",
            "null"
          ]
        },
        "metadata": {
          "$ref": "#/definitions/Metadata"
        },
        "minters": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "subdenom": {
          "$ref": "#/definitions/HeadstashTokenObject"
        }
      },
      "additionalProperties": false
    },
    "TokenStrategy": {
      "oneOf": [
        {
          "description": "Create new token via TokenFactory",
          "type": "object",
          "required": [
            "new_fungible"
          ],
          "properties": {
            "new_fungible": {
              "$ref": "#/definitions/NewTokenConfig"
            }
          },
          "additionalProperties": false
        },
        {
          "description": "Use existing denom (must pre-fund contract)",
          "type": "object",
          "required": [
            "existing_fungible"
          ],
          "properties": {
            "existing_fungible": {
              "$ref": "#/definitions/HeadstashTokenObject"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "Uint128": {
      "description": "A thin wrapper around u128 that is using strings for JSON encoding/decoding, such that the full u128 range can be used for clients that convert JSON numbers to floats, like JavaScript and jq.\n\n# Examples\n\nUse `from` to create instances of this and `u128` to get the value out:\n\n``` # use cosmwasm_std::Uint128; let a = Uint128::from(123u128); assert_eq!(a.u128(), 123);\n\nlet b = Uint128::from(42u64); assert_eq!(b.u128(), 42);\n\nlet c = Uint128::from(70u32); assert_eq!(c.u128(), 70); ```",
      "type": "string"
    },
    "WavsAuthMetadata": {
      "description": "[WavsAuthMetadata] is the object hashed and signed by all operator keys during proof of ownership & key rotation requests.",
      "type": "object",
      "required": [
        "aggregate_key",
        "nonce",
        "threshold",
        "total_operators"
      ],
      "properties": {
        "aggregate_key": {
          "type": "string"
        },
        "nonce": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "threshold": {
          "type": "integer",
          "format": "uint",
          "minimum": 0.0
        },
        "total_operators": {
          "type": "integer",
          "format": "uint",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    },
    "WavsOpAuth": {
      "type": "object",
      "required": [
        "key",
        "poo"
      ],
      "properties": {
        "key": {
          "description": "<contract-addr>-<pubkey>>, where pubkey is the `bls12_381`,and contract-addr is this contract-addr",
          "type": "string"
        },
        "poo": {
          "description": "proof of ownership signature of `H(WavsAuthMetadata)` from the public key",
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "WavsProofOfOwnership": {
      "type": "object",
      "required": [
        "msg",
        "poos"
      ],
      "properties": {
        "msg": {
          "description": "msg that is used as dst for signing and hashing operators for offchain validation",
          "allOf": [
            {
              "$ref": "#/definitions/WavsAuthMetadata"
            }
          ]
        },
        "poos": {
          "description": "list of aggregated keys (used for proof of ownership)",
          "type": "array",
          "items": {
            "$ref": "#/definitions/WavsOpAuth"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
