{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ExecuteMsg",
  "oneOf": [
    {
      "description": "Verify claims and distribute. Each claim binds to a registered `root_id`.",
      "type": "object",
      "required": [
        "process_headstash"
      ],
      "properties": {
        "process_headstash": {
          "type": "object",
          "required": [
            "claims"
          ],
          "properties": {
            "claims": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/HeadstashNote"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Owner: bind wasmvm store-circuit id used by `proof_instance_verify`.",
      "type": "object",
      "required": [
        "set_circuit_id"
      ],
      "properties": {
        "set_circuit_id": {
          "type": "object",
          "required": [
            "circuit_id"
          ],
          "properties": {
            "circuit_id": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0.0
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Register an **additive** eligibility root (Poseidon-v1 only for new drops). Owner-only. Assigns the next `root_id` and stores root + domain.",
      "type": "object",
      "required": [
        "register_eligibility_root"
      ],
      "properties": {
        "register_eligibility_root": {
          "type": "object",
          "required": [
            "root"
          ],
          "properties": {
            "domain": {
              "description": "If omitted, uses the contract's default `distro_hash_domain` (must still pass additive policy — Poseidon-v1 for new roots).",
              "default": null,
              "anyOf": [
                {
                  "$ref": "#/definitions/DistroHashDomain"
                },
                {
                  "type": "null"
                }
              ]
            },
            "label": {
              "default": null,
              "type": [
                "string",
                "null"
              ]
            },
            "root": {
              "description": "32-byte distro tree root.",
              "allOf": [
                {
                  "$ref": "#/definitions/Binary"
                }
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "mint"
      ],
      "properties": {
        "mint": {
          "type": "object",
          "required": [
            "amount",
            "to_address"
          ],
          "properties": {
            "amount": {
              "$ref": "#/definitions/Uint128"
            },
            "to_address": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "burn"
      ],
      "properties": {
        "burn": {
          "type": "object",
          "required": [
            "amount",
            "from_address"
          ],
          "properties": {
            "amount": {
              "$ref": "#/definitions/Uint128"
            },
            "from_address": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Advance reflection / LC attested roots (owner/operator).",
      "type": "object",
      "required": [
        "update_reflection"
      ],
      "properties": {
        "update_reflection": {
          "type": "object",
          "required": [
            "burn_root",
            "pool_root",
            "source_height",
            "spent_root",
            "tip_height"
          ],
          "properties": {
            "burn_root": {
              "$ref": "#/definitions/Binary"
            },
            "pool_root": {
              "$ref": "#/definitions/Binary"
            },
            "source_height": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0.0
            },
            "spent_root": {
              "$ref": "#/definitions/Binary"
            },
            "tip_height": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0.0
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Replace full reflection snapshot (includes K, lag, frozen).",
      "type": "object",
      "required": [
        "set_reflection_snapshot"
      ],
      "properties": {
        "set_reflection_snapshot": {
          "type": "object",
          "required": [
            "snapshot"
          ],
          "properties": {
            "snapshot": {
              "$ref": "#/definitions/ReflectionSnapshot"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Register asset in **internal** registry (never mints balances).",
      "type": "object",
      "required": [
        "register_asset"
      ],
      "properties": {
        "register_asset": {
          "type": "object",
          "required": [
            "asset_id",
            "local_denom"
          ],
          "properties": {
            "asset_id": {
              "description": "32-byte Terp asset id (or mapped tacit id used as key).",
              "allOf": [
                {
                  "$ref": "#/definitions/Binary"
                }
              ]
            },
            "local_denom": {
              "description": "Local denom / proof representation.",
              "type": "string"
            },
            "origin": {
              "description": "Optional origin tag (`native`, `tacit:…`, IBC trace).",
              "default": null,
              "type": [
                "string",
                "null"
              ]
            },
            "status": {
              "default": null,
              "anyOf": [
                {
                  "$ref": "#/definitions/AssetStatus"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Optional external asset registry contract address (hook; not required for demos).",
      "type": "object",
      "required": [
        "set_external_asset_registry"
      ],
      "properties": {
        "set_external_asset_registry": {
          "type": "object",
          "properties": {
            "addr": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Owner-set bridge corridor config (dest domain, K, lag, mock_verify).",
      "type": "object",
      "required": [
        "set_bridge_cfg"
      ],
      "properties": {
        "set_bridge_cfg": {
          "type": "object",
          "required": [
            "cfg"
          ],
          "properties": {
            "cfg": {
              "$ref": "#/definitions/BridgeCfg"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "One-shot bridge mint → SEAM-NOTE-OUT note result. Proof verify is **mock/stub** in Round 2 (`mock_verify` or cfg(test)).",
      "type": "object",
      "required": [
        "bridge_mint_note"
      ],
      "properties": {
        "bridge_mint_note": {
          "type": "object",
          "required": [
            "claim",
            "proof"
          ],
          "properties": {
            "claim": {
              "$ref": "#/definitions/BridgeMintClaimPublic"
            },
            "proof": {
              "description": "Opaque membership / reflection receipt (mock or SP1 later).",
              "allOf": [
                {
                  "$ref": "#/definitions/Binary"
                }
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Option D private-bridge **egress burn** (ZEC SEAM → preauth dest). Dual-path: `BridgeCfg.mock_verify` / cfg(test) lab, or `zk-api` + `egress_zkid`. Spent under egress-nf-v0 domain (≠ pool-nf, ≠ bridge mint ν).",
      "type": "object",
      "required": [
        "bridge_egress_burn"
      ],
      "properties": {
        "bridge_egress_burn": {
          "type": "object",
          "required": [
            "proof",
            "statement"
          ],
          "properties": {
            "proof": {
              "description": "Opaque membership / spend proof (mock or Halo2 later).",
              "allOf": [
                {
                  "$ref": "#/definitions/Binary"
                }
              ]
            },
            "statement": {
              "$ref": "#/definitions/EgressBurnStatement"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Owner: fixed CHT amounts for the public Ethereum path. Index `i` pays `amounts[i]`.",
      "type": "object",
      "required": [
        "set_denom_table"
      ],
      "properties": {
        "set_denom_table": {
          "type": "object",
          "required": [
            "amounts"
          ],
          "properties": {
            "amounts": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "uint64",
                "minimum": 0.0
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Owner: these nullifiers are paid only by the public batch, not the Halo2 batch.",
      "type": "object",
      "required": [
        "assign_public_notes"
      ],
      "properties": {
        "assign_public_notes": {
          "type": "object",
          "required": [
            "nullifiers"
          ],
          "properties": {
            "nullifiers": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Binary"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Pay a Halo2 epoch batch whose aggregate is the stored `headstash-accepted` root. Does not verify the proof.",
      "type": "object",
      "required": [
        "apply_accepted_batch"
      ],
      "properties": {
        "apply_accepted_batch": {
          "type": "object",
          "required": [
            "allocation_root",
            "root_id",
            "rows"
          ],
          "properties": {
            "allocation_root": {
              "$ref": "#/definitions/Binary"
            },
            "root_id": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0.0
            },
            "rows": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/EpochPayout"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Pay opened Pedersen destinations for Ethereum logs of fixed denomination indexes.",
      "type": "object",
      "required": [
        "apply_public_batch"
      ],
      "properties": {
        "apply_public_batch": {
          "type": "object",
          "required": [
            "rows"
          ],
          "properties": {
            "rows": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/PublicOpen"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  ],
  "definitions": {
    "AssetStatus": {
      "type": "string",
      "enum": [
        "active",
        "paused",
        "frozen"
      ]
    },
    "Binary": {
      "description": "Binary is a wrapper around Vec<u8> to add base64 de/serialization with serde. It also adds some helper methods to help encode inline.\n\nThis is only needed as serde-json-{core,wasm} has a horrible encoding for Vec<u8>. See also <https://github.com/CosmWasm/cosmwasm/blob/main/docs/MESSAGE_TYPES.md>.",
      "type": "string"
    },
    "BridgeCfg": {
      "type": "object",
      "required": [
        "confirmations_k",
        "dest_domain",
        "lc_client_id",
        "max_lc_lag",
        "mock_verify"
      ],
      "properties": {
        "confirmations_k": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "dest_domain": {
          "description": "Terp destination domain / chain bind (32 bytes).",
          "allOf": [
            {
              "$ref": "#/definitions/Binary"
            }
          ]
        },
        "egress_zkid": {
          "description": "Circuit id for Option D egress `proof_instance_verify` (production path). Lab / mock_verify ignores this. Default `None` keeps existing BridgeCfg JSON valid.",
          "default": null,
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "lc_client_id": {
          "description": "LC client id string (reflection corridor).",
          "type": "string"
        },
        "max_lc_lag": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "mock_verify": {
          "description": "When true, proof verify is mocked (always-ok membership under claim flags). Production must set false and wire real verify.",
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "BridgeMintClaimPublic": {
      "description": "Mint-critical public claim fields (Domain B §9 + C §3.1).",
      "type": "object",
      "required": [
        "burn_dest_commitment",
        "claim_id",
        "cm_public",
        "dest_commitment",
        "dest_domain",
        "domain_binding",
        "dst_chain_id",
        "in_burn_set",
        "in_pool_root",
        "lc_client_id",
        "nullifier",
        "pool_domain",
        "source_burn_root",
        "source_chain_tag",
        "source_height",
        "source_pool_root",
        "src_chain_id",
        "tacit_asset_id",
        "unit_scale",
        "value_u64"
      ],
      "properties": {
        "burn_dest_commitment": {
          "description": "Burn-bound destCommitment recorded in burn set (A6).",
          "allOf": [
            {
              "$ref": "#/definitions/Binary"
            }
          ]
        },
        "claim_id": {
          "$ref": "#/definitions/Binary"
        },
        "cm_public": {
          "$ref": "#/definitions/Binary"
        },
        "dest_commitment": {
          "$ref": "#/definitions/Binary"
        },
        "dest_domain": {
          "$ref": "#/definitions/Binary"
        },
        "domain_binding": {
          "$ref": "#/definitions/Binary"
        },
        "dst_chain_id": {
          "$ref": "#/definitions/Binary"
        },
        "in_burn_set": {
          "description": "ν present in bridge-burn set under snapshot.burn_root.",
          "type": "boolean"
        },
        "in_pool_root": {
          "description": "Burned note membership under pool root.",
          "type": "boolean"
        },
        "lc_client_id": {
          "$ref": "#/definitions/Binary"
        },
        "nullifier": {
          "$ref": "#/definitions/Binary"
        },
        "pool_domain": {
          "$ref": "#/definitions/Binary"
        },
        "rcm": {
          "description": "Optional opening trapdoor; non-zero → note rcm_flag=1.",
          "default": null,
          "anyOf": [
            {
              "$ref": "#/definitions/Binary"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_burn_root": {
          "$ref": "#/definitions/Binary"
        },
        "source_chain_tag": {
          "type": "string"
        },
        "source_height": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "source_pool_root": {
          "$ref": "#/definitions/Binary"
        },
        "spent_only": {
          "description": "True if ν is only in spent set (H-1 reject when !in_burn_set).",
          "default": false,
          "type": "boolean"
        },
        "src_chain_id": {
          "description": "Expected domain_binding re-derive inputs.",
          "allOf": [
            {
              "$ref": "#/definitions/Binary"
            }
          ]
        },
        "tacit_asset_id": {
          "$ref": "#/definitions/Binary"
        },
        "unit_scale": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "value_u64": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    },
    "DestKind": {
      "description": "Zcash receiver class — metadata for wallet API selection; binding stays 32B seal.",
      "type": "string",
      "enum": [
        "transparent",
        "shielded"
      ]
    },
    "DistroHashDomain": {
      "description": "Wire / JSON unit names are `poseidon_v1` / `sinsemilla_legacy` (cw_serde identifiers). Human/ADR tags from [`DistroHashDomain::as_str`] are `poseidon-v1` / `sinsemilla-legacy`.\n\nNew Headstashes default to [`DistroHashDomain::PoseidonV1`]. [`DistroHashDomain::SinsemillaLegacy`] is recovery-only for pre-Poseidon trees.",
      "oneOf": [
        {
          "description": "Poseidon over `pallas::Base` — ADR default for public inclusion.",
          "type": "string",
          "enum": [
            "poseidon_v1"
          ]
        },
        {
          "description": "Orchard-family Sinsemilla — legacy recovery only; not for new drops.",
          "type": "string",
          "enum": [
            "sinsemilla_legacy"
          ]
        }
      ]
    },
    "EgressBurnStatement": {
      "description": "Public statement for Option D burn on Terp (+ lab openings for structural ν / dest).\n\nLayout mirrors pure `EgressBurnPublic` + witness openings (`rcm`, `owner_binding`) so the contract can fail-closed on dest equality and nullifier re-derive without a full ZK circuit this wave.",
      "type": "object",
      "required": [
        "asset_id",
        "cm_spent",
        "dest_commitment",
        "dest_kind",
        "nullifier",
        "owner_binding",
        "rcm",
        "root",
        "value"
      ],
      "properties": {
        "asset_id": {
          "$ref": "#/definitions/Binary"
        },
        "cm_spent": {
          "description": "SEAM cm being burned.",
          "allOf": [
            {
              "$ref": "#/definitions/Binary"
            }
          ]
        },
        "dest_commitment": {
          "description": "MUST equal G4 seal / owner_binding.",
          "allOf": [
            {
              "$ref": "#/definitions/Binary"
            }
          ]
        },
        "dest_kind": {
          "$ref": "#/definitions/DestKind"
        },
        "nullifier": {
          "description": "Egress-domain ν: `H(\"egress-nf-v0\" ‖ cm_spent ‖ rcm)`.",
          "allOf": [
            {
              "$ref": "#/definitions/Binary"
            }
          ]
        },
        "owner_binding": {
          "description": "Must equal `dest_commitment` on corridor product.",
          "allOf": [
            {
              "$ref": "#/definitions/Binary"
            }
          ]
        },
        "rcm": {
          "description": "Opening for ν re-derive (lab / structural).",
          "allOf": [
            {
              "$ref": "#/definitions/Binary"
            }
          ]
        },
        "root": {
          "description": "Membership root (lab stub OK).",
          "allOf": [
            {
              "$ref": "#/definitions/Binary"
            }
          ]
        },
        "source_pool_id": {
          "description": "If from swap settle.",
          "default": null,
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "value": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    },
    "EpochPayout": {
      "type": "object",
      "required": [
        "amount",
        "denom",
        "destination",
        "nullifier"
      ],
      "properties": {
        "amount": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "denom": {
          "description": "32-byte circuit denomination.",
          "allOf": [
            {
              "$ref": "#/definitions/Binary"
            }
          ]
        },
        "destination": {
          "type": "string"
        },
        "nullifier": {
          "description": "32-byte nullifier.",
          "allOf": [
            {
              "$ref": "#/definitions/Binary"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "HeadstashInstances": {
      "type": "object",
      "required": [
        "anchor",
        "cmx",
        "e",
        "nd",
        "nf",
        "recp",
        "v"
      ],
      "properties": {
        "anchor": {
          "$ref": "#/definitions/Binary"
        },
        "cmx": {
          "$ref": "#/definitions/Binary"
        },
        "e": {
          "description": "Reduced EIP-191 challenge, 32 bytes. Not part of the signed prefix.",
          "allOf": [
            {
              "$ref": "#/definitions/Binary"
            }
          ]
        },
        "nd": {
          "$ref": "#/definitions/Binary"
        },
        "nf": {
          "$ref": "#/definitions/Binary"
        },
        "recp": {
          "$ref": "#/definitions/Binary"
        },
        "v": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    },
    "HeadstashNote": {
      "type": "object",
      "required": [
        "i",
        "p",
        "rr"
      ],
      "properties": {
        "i": {
          "$ref": "#/definitions/HeadstashInstances"
        },
        "p": {
          "$ref": "#/definitions/Binary"
        },
        "root_id": {
          "description": "Eligibility root this claim proves under. Default `0` = genesis set. Circuit public input `anchor` must match the registered root for this id once Poseidon-v1 inclusion proofs are live.",
          "default": 0,
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "rr": {
          "$ref": "#/definitions/Binary"
        }
      },
      "additionalProperties": false
    },
    "PublicOpen": {
      "type": "object",
      "required": [
        "blind",
        "commitment",
        "destination",
        "index",
        "log_index",
        "nullifier",
        "tx_hash"
      ],
      "properties": {
        "blind": {
          "description": "Canonical Pallas scalar, 32 bytes. Not zero.",
          "allOf": [
            {
              "$ref": "#/definitions/Binary"
            }
          ]
        },
        "commitment": {
          "description": "Compressed Pedersen commitment, 32 bytes.",
          "allOf": [
            {
              "$ref": "#/definitions/Binary"
            }
          ]
        },
        "destination": {
          "type": "string"
        },
        "index": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "log_index": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "nullifier": {
          "description": "32-byte nullifier reserved for the public path.",
          "allOf": [
            {
              "$ref": "#/definitions/Binary"
            }
          ]
        },
        "tx_hash": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "ReflectionSnapshot": {
      "type": "object",
      "required": [
        "burn_root",
        "confirmations_k",
        "frozen",
        "max_lc_lag",
        "pool_root",
        "source_height",
        "spent_root",
        "tip_height"
      ],
      "properties": {
        "burn_root": {
          "$ref": "#/definitions/Binary"
        },
        "confirmations_k": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "frozen": {
          "type": "boolean"
        },
        "max_lc_lag": {
          "type": "integer",
          "format": "uint64",
