DISCORD_TOKEN=

DISCORD_GUILD_ID=

# LLM: prefer llm-profiles.toml (OpenCode serve + Muse Spark 1.3 free).
# Compat: if the file is missing, LLM_BASE_URL/LLM_MODEL still work.
LLM_PROFILES=llm-profiles.toml
LLM_BASE_URL=http://127.0.0.1:4096
LLM_MODEL=muse-spark-1.3-contributor-free
LLM_SUB_MODEL=muse-spark-1.3-contributor-free
LLM_API_KEY=

# Terp bot engine
# Admin allowlist: explicit user IDs and/or role IDs. Empty = guild owner only.
# Applies to: /edgar ingest, /edgar ingest-local, /terp verify, /edgar config,
# /edgar pause, /edgar resume.
ADMIN_USER_IDS=
ADMIN_ROLE_IDS=

# Ask pilot (/edgar ask and /terp ask). Fail closed.
# Kill switch: only true, 1, yes, or on turns asks on. Default off.
# /edgar pause and /edgar resume flip the runtime gate. They do not override
# a false kill switch. Empty channel or role list denies every ask. A
# non-numeric entry in either list clears that list (deny).
# To allow every member of an allowed channel, put the guild ID (the
# @everyone role ID) in ASK_ROLE_IDS.
ASK_ENABLED=false
ASK_CHANNEL_IDS=
ASK_ROLE_IDS=
ASK_COOLDOWN_SECS=30
ASK_MAX_CONCURRENT=1
# Laya gate (ec-gate). Every ask is classified before the research loop.
# Fail closed: unset URL, timeout, or error holds the question for a human.
# GATE_URL: full endpoint or bare origin (/v1/systemone is appended),
#   e.g. http://127.0.0.1:8788 -> http://127.0.0.1:8788/v1/systemone
# GATE_TOKEN: optional bearer token (matches LAYA_GATE_TOKEN on the harness).
# GATE_TIMEOUT_MS: request timeout in ms, default 15000. 0 or junk = hold.
GATE_URL=
GATE_TOKEN=
GATE_TIMEOUT_MS=15000
# Foundation DAO core (CosmWasm). Notifier stays off until this or
# DAO_ALLOWLIST is set. Address is config — there is no built-in default.
# SubDAOs of DAO_CONTRACT are polled too unless DAO_INCLUDE_SUBDAOS=false.
DAO_CONTRACT=
DAO_ALLOWLIST=
DAO_NOTIFY_CHANNEL_ID=
DAO_POLL_SECS=60
# daodao.zone link: /dao/{DAO_CHAIN_ID}/{address}/proposals/{prefix}{id}
DAO_CHAIN_ID=
DAO_UI_BASE=https://daodao.zone
DAO_INCLUDE_SUBDAOS=true
SPAM_KEYWORDS=axvdex.org,astrovault airdrop
SPAM_NOTIFY_CHANNEL_ID=
# Long timeout on spam (DA0-DA0 pattern, default 27d, Discord max 28d).
# Requires the ModerateMembers permission on invite.
SPAM_TIMEOUT_DAYS=27

# Validator liveness monitor (background task, automated messages).
# Needs TERP_NODE_REST above + the alert channel below to run.
VALIDATOR_ALERT_CHANNEL_ID=
VALIDATOR_PREFIX=terp
VALIDATOR_POLL_SECS=60
VALIDATOR_REMIND_SECS=1800

# Resource sync + live chain reads
# Directory the bot may ingest local files from (/edgar ingest-local).
# MUST be set to the terp-core root (or another reviewed tree).
# Default "." (process cwd) is NOT a jail — never run public without this.
TERP_SYNC_ROOT=
# Read-only LCD endpoint for guard-railed node_query() in the RLM loop,
# chain snapshots, and the gov/IBC/staking watch. Guest code can never change this.
# Public LCD: https://api.terp.network (HTTPS on 443). Do not use
# https://api.terp.network:1317 — that port does not accept connections.
# A local terpd LCD is typically http://127.0.0.1:1317.
TERP_NODE_REST=
# Chain watch posts gov alerts to #gov-updates. The loop itself starts when
# CHAIN_ALERT_CHANNEL_ID or VALIDATOR_ALERT_CHANNEL_ID is set. If
# GOV_ALERT_CHANNEL_ID is unset, gov messages fall back to the activity
# channel and #gov-updates stays empty. config/terp-chains.example.yaml is
# not read by the bot.
CHAIN_ALERT_CHANNEL_ID=
GOV_ALERT_CHANNEL_ID=
ACTIVITY_CHANNEL_ID=
# Proposal links are {GOV_EXPLORER_BASE}/{id}. Default is ping.pub, the
# explorer chain-registry lists first for terpnetwork.
GOV_EXPLORER_BASE=https://ping.pub/terp/gov
# On-demand digests only (/terp digest-preview). There is no scheduler:
# DIGEST_CHANNEL_ID / DIGEST_HOUR_UTC style cron does not exist.

# Sandbox executor (the ONLY backend — no opt-out, no RLM_SANDBOX flag).
# Guest is a network-less WASIX python; corpus is a read-only mount.
# Pin the package for reproducibility, e.g. python/python@=3.13.18.
WASMER_PYTHON_PACKAGE=python/python
RLM_SANDBOX_TIMEOUT_SECS=90
RLM_SANDBOX_HISTORY_MAX=24000
RLM_SANDBOX_SNAPSHOT_MAX=8388608