# Host-only LLM profiles. Guest never sees these.
# Free ACP models, failover order. A missing model (older opencode) or a
# timeout fails over to the next profile. timeout_ms is optional (default
# 45000). Jail permission is "ask" and the ACP client rejects every request:
# a deny-all config strips opencode tools and Zen free tier then refuses with
# "free tier can only be used from within OpenCode".

[[profiles]]
name = "deepseek-v4.1-flash-free"
kind = "acp"
command = "opencode"
args = ["acp", "--pure"]
model = "opencode/deepseek-v4.1-flash-free"
cwd = "/opt/terp-bot/opencode-jail"
timeout_ms = 45000

[[profiles]]
name = "muse-spark-1.3-contributor-free"
kind = "acp"
command = "opencode"
args = ["acp", "--pure"]
model = "opencode/muse-spark-1.3-contributor-free"
cwd = "/opt/terp-bot/opencode-jail"
timeout_ms = 45000

[[profiles]]
name = "nemotron-3.5-lightning-free"
kind = "acp"
command = "opencode"
args = ["acp", "--pure"]
model = "opencode/nemotron-3.5-lightning-free"
cwd = "/opt/terp-bot/opencode-jail"
timeout_ms = 45000
