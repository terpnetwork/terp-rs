{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "terp:svg-collections/symbient-day-record/v2",
 "title": "Symbient day record (one per persona per UTC day)",
 "type": "object",
 "required": [
  "schema",
  "persona",
  "day",
  "day_index",
  "prev_record_sha256",
  "day_seed",
  "picks",
  "memory",
  "interactions",
  "model",
  "frames",
  "packed_sha256",
  "disclaimer",
  "record_sha256"
 ],
 "properties": {
  "schema": {
   "enum": [
    "symbient-day-record/v1",
    "symbient-day-record/v2"
   ]
  },
  "persona": {
   "type": "string",
   "pattern": "^[a-z0-9-]{3,32}$"
  },
  "day": {
   "type": "string",
   "format": "date"
  },
  "day_index": {
   "type": "integer",
   "minimum": 0
  },
  "prev_record_sha256": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}$",
   "description": "64 zeros on day 0; hash chain"
  },
  "day_seed": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}$",
   "description": "sha256(persona|day|prev_record_sha256)"
  },
  "picks": {
   "type": "array",
   "minItems": 1,
   "maxItems": 2,
   "items": {
    "type": "object",
    "required": [
     "slug",
     "name",
     "url",
     "classes",
     "acute_toxicity",
     "effects"
    ],
    "properties": {
     "slug": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "url": {
      "type": "string",
      "format": "uri"
     },
     "page_updated": {
      "type": [
       "string",
       "null"
      ]
     },
     "classes": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "acute_toxicity": {
      "type": "string",
      "description": "psychedex acute-toxicity label, any value (filters off by default since v2); 'unknown' if absent - never shown as safe"
     },
     "effects": {
      "type": "array",
      "maxItems": 4,
      "items": {
       "type": "string"
      }
     }
    },
    "not": {
     "anyOf": [
      {
       "required": [
        "dose"
       ]
      },
      {
       "required": [
        "doses"
       ]
      }
     ]
    }
   }
  },
  "memory": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "slug",
     "weight",
     "first_day_index",
     "last_day_index"
    ],
    "properties": {
     "slug": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "weight": {
      "type": "integer",
      "minimum": 100,
      "maximum": 3000
     },
     "first_day_index": {
      "type": "integer"
     },
     "last_day_index": {
      "type": "integer"
     }
    }
   }
  },
  "interactions": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "a",
     "b",
     "severity",
     "source_url"
    ],
    "properties": {
     "a": {
      "type": "string"
     },
     "b": {
      "type": "string"
     },
     "severity": {
      "enum": [
       "lethal",
       "dangerous",
       "caution",
       "low risk",
       "low_risk",
       "no known interaction",
       "unknown"
      ]
     },
     "rule": {
      "type": "string"
     },
     "standing": {
      "type": "string"
     },
     "confidence": {
      "type": "string"
     },
     "note": {
      "type": "string"
     },
     "source_url": {
      "type": [
       "string",
       "null"
      ]
     }
    }
   }
  },
  "flicker": {
   "type": [
    "string",
    "null"
   ]
  },
  "environment": {
   "type": [
    "object",
    "null"
   ],
   "required": [
    "submission_id",
    "text_sha256"
   ],
   "properties": {
    "submission_id": {
     "type": "string"
    },
    "text_sha256": {
     "type": "string",
     "pattern": "^[0-9a-f]{64}$"
    }
   }
  },
  "model": {
   "type": "object",
   "required": [
    "runtime",
    "name",
    "digest"
   ],
   "properties": {
    "runtime": {
     "enum": [
      "ollama",
      "llama.cpp"
     ]
    },
    "name": {
     "type": "string"
    },
    "digest": {
     "type": "string"
    }
   }
  },
  "frames": {
   "type": "array",
   "minItems": 1,
   "maxItems": 8,
   "items": {
    "type": "object",
    "required": [
     "seed",
     "options",
     "prompt_sha256",
     "raw_sha256",
     "sanitized_sha256",
     "masked_dose_tokens",
     "ink_permille"
    ],
    "properties": {
     "seed": {
      "type": "integer"
     },
     "options": {
      "type": "object"
     },
     "prompt_sha256": {
      "type": "string"
     },
     "raw_sha256": {
      "type": "string"
     },
     "sanitized_sha256": {
      "type": "string"
     },
     "rejected_attempts": {
      "type": "array"
     },
     "replaced_chars": {
      "type": "integer"
     },
     "masked_dose_tokens": {
      "type": "integer"
     },
     "ink_permille": {
      "type": "integer"
     }
    }
   }
  },
  "packed_sha256": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}$"
  },
  "packed_bytes": {
   "type": "integer"
  },
  "disclaimer": {
   "type": "string"
  },
  "record_sha256": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}$",
   "description": "sha256 of canonical JSON (sorted keys, no spaces) of the record WITHOUT this field. Used as the cw721-svg collection seed."
  },
  "practice": {
   "type": [
    "object",
    "null"
   ],
   "required": [
    "slug",
    "name",
    "category",
    "url"
   ],
   "properties": {
    "slug": {
     "type": "string"
    },
    "name": {
     "type": "string"
    },
    "category": {
     "type": "string"
    },
    "url": {
     "type": "string",
     "format": "uri"
    },
    "effects": {
     "type": "array",
     "maxItems": 4,
     "items": {
      "type": "string"
     }
    }
   }
  },
  "practice_interactions": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "practice",
     "substance",
     "severity",
     "standing",
     "excerpt",
     "source_url"
    ],
    "properties": {
     "practice": {
      "type": "string"
     },
     "substance": {
      "type": "string"
     },
     "matched": {
      "type": "string"
     },
     "section": {
      "enum": [
       "Substance Interactions",
       "Contraindications"
      ]
     },
     "cue": {
      "enum": [
       "risk",
       "attenuates",
       "adjunct",
       "mention"
      ]
     },
     "severity": {
      "const": "unrated",
      "description": "practice pages carry prose, not graded severities; unrated is never safe"
     },
     "standing": {
      "type": "string"
     },
     "excerpt": {
      "type": "string",
      "maxLength": 320,
      "not": {
       "pattern": "\\b\\d+(\\.\\d+)?\\s?(mg|mcg|ug|µg|g|ml)\\b"
      }
     },
     "source_url": {
      "type": "string",
      "format": "uri"
     }
    }
   }
  },
  "filters": {
   "type": "object",
   "properties": {
    "enabled": {
     "type": "boolean",
     "description": "opt-in blocklist + toxicity filter; default false (user decision, iteration 3)"
    }
   }
  }
 },
 "allOf": [
  {
   "if": {
    "properties": {
     "schema": {
      "const": "symbient-day-record/v2"
     }
    }
   },
   "then": {
    "required": [
     "practice",
     "practice_interactions",
     "filters"
    ]
   }
  }
 ]
}