# Copy to this directory as .env (gitignored). gov_fund loads that file.
# vote_yes.sh loads it when ENV_FILE points here.
# Never commit real mnemonics.
#
# MAIN_MNEMONIC is the hot wallet that broadcasts cosmos gov MsgDeposit.
# It is not a DAO voter. DAO_MEMBER1_MNEMONIC and DAO_MEMBER2_MNEMONIC are
# the two cw4 members whose yes votes pass a proposal immediately.
# DAO_MEMBER3_MNEMONIC is unused by gov_fund.

MAIN_MNEMONIC=
DAO_MEMBER1_MNEMONIC=
DAO_MEMBER2_MNEMONIC=
DAO_MEMBER3_MNEMONIC=

CHAIN_ID=morocco-1
GRPC_URL=http://192.168.10.101:9090
LCD_URL=http://192.168.10.101:1317
RPC_URL=http://192.168.10.101:26657
GAS_DENOM=uthiol
GAS_PRICE=0.05
ADDRESS_PREFIX=terp

# quorum_broadcast. Two different accounts. The consensus key stays in the
# node home; it is not a mnemonic. Copy this file to .env (gitignored).
# OPERATOR signs create-validator. FOUNDATION signs the send and redelegations.
TERPZ_OPERATOR_MNEMONIC=
TERPZ_FOUNDATION_MNEMONIC=
