  "collection_info_extension": {
    "seed": "qPlFZx3y4gaF+3JDsoebF01jPoopMT4qLIh4GufpotI=",
    "svg_template": "<svg xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" version=\"1.1\" id=\"Layer_1\" x=\"0px\" y=\"0px\" viewBox=\"0 0 375 346.5\" style=\"enable-background:new 0 0 375 346.5;\" xml:space=\"preserve\">\n<style type=\"text/css\">\n  :root {\n    --color-ring1: ${color-ring1};\n    --color-ring2: ${color-ring2};\n    --color-ring3: ${color-ring3};\n    --color-ring4: ${color-ring4};\n    --color-ring5: ${color-ring5};\n  }\n\n  /*\n   * Tentacle-whip oscillation:\n   * Each ring rotates around the SVG center (187.5, 173.25) with a sinusoidal\n   * swing. Outer rings swing wider (larger angle) and have a propagation delay\n   * creating the \"whip\" effect \u2014 motion originates from the core and ripples\n   * outward with increasing amplitude, like octopus tentacles seen from above.\n   *\n   * The easing uses cubic-bezier for an organic snap-back feel.\n   */\n\n  .ring1 { fill: var(--color-ring1); }\n  .ring2 { fill: var(--color-ring2); }\n  .ring3 { fill: var(--color-ring3); }\n  .ring4 { fill: var(--color-ring4); }\n  .ring5 { fill: var(--color-ring5); }\n\n  /* Ring group transforms \u2014 all pivot around SVG center */\n  .ring-group {\n    transform-origin: 187.5px 173.25px;\n  }\n\n  /* Ring 1: innermost \u2014 subtle sway, fastest cycle, no delay */\n  .rg1 {\n    animation: swirl1 ${drift-ring1}s cubic-bezier(0.45, 0.05, 0.55, 0.95) infinite alternate;\n    animation-delay: 0s;\n  }\n  @keyframes swirl1 {\n    0%   { transform: rotate(-3deg); }\n    100% { transform: rotate(3deg); }\n  }\n\n  /* Ring 2: slight increase in swing, tiny whip delay */\n  .rg2 {\n    animation: swirl2 ${drift-ring2}s cubic-bezier(0.45, 0.05, 0.55, 0.95) infinite alternate;\n    animation-delay: ${val-delay2}s;\n  }\n  @keyframes swirl2 {\n    0%   { transform: rotate(-6deg); }\n    100% { transform: rotate(6deg); }\n  }\n\n  /* Ring 3: medium swing \u2014 tentacle mid-section */\n  .rg3 {\n    animation: swirl3 ${drift-ring3}s cubic-bezier(0.33, 0.00, 0.67, 1.00) infinite alternate;\n    animation-delay: ${val-delay3}s;\n  }\n  @keyframes swirl3 {\n    0%   { transform: rotate(-12deg); }\n    100% { transform: rotate(12deg); }\n  }\n\n  /* Ring 4: wide swing \u2014 outer tentacle with whip snap */\n  .rg4 {\n    animation: swirl4 ${drift-ring4}s cubic-bezier(0.22, 0.61, 0.36, 1.00) infinite alternate;\n    animation-delay: ${val-delay4}s;\n  }\n  @keyframes swirl4 {\n    0%   { transform: rotate(-20deg); }\n    100% { transform: rotate(20deg); }\n  }\n\n  /* Ring 5: outermost \u2014 maximum whip amplitude, longest delay */\n  .rg5 {\n    animation: swirl5 ${drift-ring5}s cubic-bezier(0.22, 0.61, 0.36, 1.00) infinite alternate;\n    animation-delay: ${val-delay5}s;\n  }\n  @keyframes swirl5 {\n    0%   { transform: rotate(-30deg); }\n    100% { transform: rotate(30deg); }\n  }\n\n  /* Subtle scale-pulse on outer rings for organic feel */\n  .rg4, .rg5 {\n    animation:\n      swirl4 ${drift-ring4}s cubic-bezier(0.22, 0.61, 0.36, 1.00) infinite alternate,\n      tentacle-breathe ${pulse-outer}s ease-in-out infinite;\n  }\n  .rg5 {\n    animation:\n      swirl5 ${drift-ring5}s cubic-bezier(0.22, 0.61, 0.36, 1.00) infinite alternate,\n      tentacle-breathe ${pulse-outer}s ease-in-out infinite;\n  }\n\n  @keyframes tentacle-breathe {\n    0%, 100% { opacity: 1; }\n    50%      { opacity: ${opacity-breathe-lo}; }\n  }\n</style>\n\n<g id=\"Layer_2_1_\">\n  <g id=\"Layer_1-2\">\n\n    <!-- \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 -->\n    <!-- RING 1: Innermost core \u2014 2 large dots (E/W axis)          -->\n    <!-- \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550