        "pulse-a", "pulse-b", "pulse-c", "pulse-d", "pulse-e",
        "pulse-f", "pulse-g", "pulse-h", "pulse-i", "pulse-j",
        "pulse-k", "pulse-l", "pulse-m"
      ],
      "min": "1.2",
      "max": "4.5",
      "precision": 2
    },
    {
      "id": "strobe",
      "note": "Fast strobe flicker — each orb blinks at its own frequency for a chaotic strobe field. Range matches the original SVG timings (0.11s–0.46s). Unit is appended by the template (${flicker-a}s).",
