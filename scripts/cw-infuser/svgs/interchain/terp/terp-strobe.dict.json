{
  "version": "1",
  "collection": "terp-strobe",
  "description": "13-orb neon-green strobe grid on a translucent black field. Each orb has an independent slow breath-pulse and a fast strobe-flicker, all sharing a single neon-glow filter. Colors are subtle gradients and shades of vibrant neon green (lime → mint family) for a unified, electric cyber aesthetic that directly matches the original SVG's classic #cfffcf / #e8ffdb energy.",

  "palette_groups": [
    {
      "id": "orb",
      "note": "All 13 orb fill colors plus the shared glow filter. Constrained exclusively to bright neon-green / lime / mint shades with high brightness and subtle natural variation — no cyan/magenta/yellow hues.",
      "entropy": "medium",
      "anchor": "glow-color",
      "members": [
        "color-a", "color-b", "color-c", "color-d", "color-e",
        "color-f", "color-g", "color-h", "color-i", "color-j",
        "color-k", "color-l", "color-m"
      ],
      "ranges": [
        { "r_min": 160, "r_max": 255, "g_min": 240, "g_max": 255, "b_min": 160, "b_max": 255 }
      ]
    }
  ],

  "motion_groups": [
    {
      "id": "breath",
      "note": "Slow neon breath pulse — each orb expands and contracts at its own chaotic rate. Range matches the original SVG timings (1.39s–4.07s). Unit is appended by the template (${pulse-a}s).",
