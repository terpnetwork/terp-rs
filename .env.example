# crates/terp-rs/.env  — local only (gitignored). Never commit real seeds or RPC URLs.
# cw-orch: TEST_MNEMONIC / ICT_TEST_MNEMONIC for local/test Daemon; MAIN_MNEMONIC for live.
# Leave empty in this example. Populate .env on the operator machine only.

TEST_MNEMONIC=
ICT_TEST_MNEMONIC=
MAIN_MNEMONIC=

# HashMerchant onboard — authorizer is the Daemon sender (those mnemonics).
# Runtime is the other account that will feegrant new users.
ONBOARD_DAO=
ONBOARD_RUNTIME=
ONBOARD_CHAIN=120u-1
ONBOARD_PENDING_MAX=128
ONBOARD_BROADCAST=0
